<UserControl x:Class="VatscaUpdateChecker.ControllerProfileControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource AppBg}" FontSize="{DynamicResource TextSize12}">

    <UserControl.Resources>
        <Style x:Key="ProfileInfoButton" TargetType="Button" BasedOn="{StaticResource ThemedButton}">
            <Setter Property="Content" Value="ⓘ"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontSize" Value="{DynamicResource TextSize14}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="AutomationProperties.HelpText" Value="{Binding ToolTip.Content.Text, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
            <EventSetter Event="Click" Handler="ProfileInfo_Open"/>
            <EventSetter Event="GotKeyboardFocus" Handler="ProfileInfo_Open"/>
            <EventSetter Event="LostKeyboardFocus" Handler="ProfileInfo_Close"/>
            <EventSetter Event="Unloaded" Handler="ProfileInfo_Close"/>
            <EventSetter Event="PreviewKeyDown" Handler="ProfileInfo_KeyDown"/>
        </Style>
        <Style x:Key="ProfileHelpTip" TargetType="ToolTip">
            <Setter Property="Placement" Value="Bottom"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="{DynamicResource TextSize12}"/>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="0">

        <ScrollViewer x:Name="ResultScroll" DockPanel.Dock="Bottom" MaxHeight="90" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="ResultText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryText}" AutomationProperties.LiveSetting="Polite"/>
        </ScrollViewer>
        <Button x:Name="RetryLoadButton" DockPanel.Dock="Bottom" Content="Try loading saved details again"
                HorizontalAlignment="Left" Padding="8,5" Margin="0,8,0,0" Visibility="Collapsed" Click="RetryLoad_Click"/>
        <WrapPanel x:Name="FooterActions" DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="PreviewButton" Content="Preview" MinWidth="80" Margin="0,0,8,0"
                    Click="Preview_Click" Padding="0,7" Cursor="Hand"/>
            <Button x:Name="SaveProfileButton" Content="Save &amp; apply" MinWidth="110" Margin="0,0,8,0"
                    Click="Save_Click"
                    Background="#1a475f" Foreground="White"
                    BorderThickness="0" Padding="12,7" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsPressed"   Value="True"><Setter Property="Opacity" Value="0.7"/></Trigger>
                            <Trigger Property="IsEnabled"   Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </WrapPanel>

        <ScrollViewer x:Name="ProfileFormScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
        <!-- Sync status banner -->
        <Border x:Name="SyncBanner"
                Padding="10,8" Margin="0,0,0,12">
            <TextBlock x:Name="SyncText" Foreground="{DynamicResource WarningFg}" FontSize="{DynamicResource TextSize12}" TextWrapping="Wrap"/>
        </Border>

        <Grid HorizontalAlignment="Left" Margin="0,0,0,2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="EuroScope profile folder" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource PrimaryText}"/>
            <Button Grid.Column="1" Style="{StaticResource ProfileInfoButton}" AutomationProperties.Name="About applying the controller profile">
                <Button.ToolTip>
                    <ToolTip Style="{StaticResource ProfileHelpTip}">
                        <TextBlock x:Name="ApplyHintText" MaxWidth="360" TextWrapping="Wrap"/>
                    </ToolTip>
                </Button.ToolTip>
            </Button>
        </Grid>
        <TextBox x:Name="TargetPathText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="80"
                 VerticalScrollBarVisibility="Auto" Padding="6,5" FontSize="{DynamicResource TextSize12}"
                 AutomationProperties.Name="EuroScope profile folder" Margin="0,0,0,12"/>

        <UniformGrid x:Name="IdentityFields" Columns="2" SizeChanged="IdentityFields_SizeChanged">
          <StackPanel Margin="0,0,12,0">
            <!-- Name -->
            <TextBlock Text="Full Name" FontWeight="SemiBold" Margin="0,0,0,4"
                       Foreground="{DynamicResource PrimaryText}"/>
            <TextBox x:Name="NameBox" Margin="0,0,0,10" Padding="6,5" FontFamily="Consolas" FontSize="{DynamicResource TextSize12}" AutomationProperties.Name="Full name"/>

          </StackPanel>
          <StackPanel Margin="0,0,12,0">
            <!-- Rating -->
            <TextBlock Text="VATSIM Rating" FontWeight="SemiBold" Margin="0,0,0,4"
                       Foreground="{DynamicResource PrimaryText}"/>
            <ComboBox x:Name="RatingBox" Margin="0,0,0,10" Padding="6,5" FontSize="{DynamicResource TextSize12}" AutomationProperties.Name="VATSIM rating"/>

          </StackPanel>
          <StackPanel Margin="0,0,12,0">
            <!-- CID -->
            <TextBlock Text="VATSIM CID" FontWeight="SemiBold" Margin="0,0,0,4"
                       Foreground="{DynamicResource PrimaryText}"/>
            <TextBox x:Name="CidBox" Margin="0,0,0,10" Padding="6,5" FontFamily="Consolas" FontSize="{DynamicResource TextSize12}" AutomationProperties.Name="VATSIM CID"/>

          </StackPanel>
          <StackPanel Margin="0,0,12,0">
            <!-- OBS Callsign -->
            <Grid HorizontalAlignment="Left" Margin="0,0,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="OBS Callsign Prefix (optional)" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Style="{StaticResource ProfileInfoButton}" AutomationProperties.Name="About the observer callsign prefix">
                    <Button.ToolTip>
                        <ToolTip Style="{StaticResource ProfileHelpTip}">
                            <TextBlock MaxWidth="360" TextWrapping="Wrap"
                                       Text="Enter ES for ES_OBS. Creates an observer login in LoginProfiles.txt. Leave blank to keep existing observer logins."/>
                        </ToolTip>
                    </Button.ToolTip>
                </Button>
            </Grid>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ObsBox" Padding="6,5" FontFamily="Consolas" FontSize="{DynamicResource TextSize12}" AutomationProperties.Name="OBS callsign prefix, optional"/>
                <TextBlock Grid.Column="1" Text="_OBS" VerticalAlignment="Center"
                           Margin="6,0,0,0" Foreground="{DynamicResource SecondaryText}"
                           FontFamily="Consolas" FontSize="{DynamicResource TextSize12}"/>
            </Grid>
          </StackPanel>
          <StackPanel Margin="0,0,12,0">
            <!-- Password -->
            <Grid HorizontalAlignment="Left" Margin="0,0,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="VATSIM Password" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}"/>
                <Button Grid.Column="1" Style="{StaticResource ProfileInfoButton}" AutomationProperties.Name="About the VATSIM password">
                    <Button.ToolTip>
                        <ToolTip Style="{StaticResource ProfileHelpTip}">
                            <TextBlock MaxWidth="360" TextWrapping="Wrap"
                                       Text="Stored in Windows Credential Manager. Save &amp; apply also copies it to configured EuroScope, vATIS and TrackAudio settings. TrackAudio stores its copy unencrypted."/>
                        </ToolTip>
                    </Button.ToolTip>
                </Button>
            </Grid>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="PasswordBox"    Padding="6,5" FontFamily="Consolas" FontSize="{DynamicResource TextSize12}" AutomationProperties.Name="VATSIM password"/>
                <TextBox    x:Name="PasswordBoxText" Padding="6,5" FontFamily="Consolas" FontSize="{DynamicResource TextSize12}"
                             Visibility="Collapsed" AutomationProperties.Name="VATSIM password, visible"/>
                <Button Grid.Column="1" x:Name="TogglePassword" Content="Show"
                        Padding="8,5" Margin="4,0,0,0" Cursor="Hand"
                        Click="TogglePassword_Click" AutomationProperties.Name="Show VATSIM password"/>
            </Grid>
          </StackPanel>
          <StackPanel Margin="0,0,12,0">
            <!-- Hoppie Code -->
            <Grid HorizontalAlignment="Left" Margin="0,0,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Hoppie ACARS Code (optional)" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Style="{StaticResource ProfileInfoButton}" AutomationProperties.Name="About the Hoppie ACARS code">
                    <Button.ToolTip>
                        <ToolTip Style="{StaticResource ProfileHelpTip}">
                            <TextBlock MaxWidth="360" TextWrapping="Wrap"
                                       Text="Your Hoppie data-link login code. Stored in Windows Credential Manager and written to plugin files when applied. Leave blank to keep existing codes in those files."/>
                        </ToolTip>
                    </Button.ToolTip>
                </Button>
            </Grid>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="HoppieBox"     Padding="6,5" FontFamily="Consolas" FontSize="{DynamicResource TextSize12}" AutomationProperties.Name="Hoppie ACARS code, optional"/>
                <TextBox    x:Name="HoppieBoxText"  Padding="6,5" FontFamily="Consolas" FontSize="{DynamicResource TextSize12}"
                             Visibility="Collapsed" AutomationProperties.Name="Hoppie ACARS code, optional, visible"/>
                <Button Grid.Column="1" x:Name="ToggleHoppie" Content="Show"
                        Padding="8,5" Margin="4,0,0,0" Cursor="Hand"
                        Click="ToggleHoppie_Click" AutomationProperties.Name="Show Hoppie ACARS code"/>
            </Grid>
          </StackPanel>
        </UniformGrid>




        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
