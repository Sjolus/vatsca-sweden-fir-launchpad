<Window x:Class="VatscaUpdateChecker.GngUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Install or update Swedish GNG" Width="1040" Height="760" MinWidth="760" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBg}" Foreground="{DynamicResource PrimaryText}"
        Closing="Window_Closing" Closed="Window_Closed">
    <Window.Resources>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource ColumnHeaderBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource ApplicationSelectedBg}"/></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ButtonFocusBorder}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FileText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="6"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,8">
            <TextBlock Text="Install or update Swedish GNG" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="StepText" Text="1  Get a package   →   2  Review and install   →   3  Optional cleanup"
                       Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Label Content="EuroScope data folder" Target="{Binding ElementName=FolderText}" Padding="0,6,8,0" Foreground="{DynamicResource PrimaryText}"/>
            <TextBox x:Name="FolderText" Grid.Column="1" IsReadOnly="True" Padding="6" AutomationProperties.Name="Reviewed EuroScope data destination"
                     ToolTip="Review this destination before installing. Close this window to choose a different folder."/>
            <CheckBox x:Name="PreserveListLayout" Grid.Row="1" Grid.Column="1" IsChecked="True" Margin="0,6,0,0" MinHeight="20" VerticalContentAlignment="Center"
                      Content="Keep my list positions and visibility" Foreground="{DynamicResource PrimaryText}"
                      Checked="PreserveListLayout_Changed" Unchecked="PreserveListLayout_Changed"
                      ToolTip="Keep each existing list's screen position and whether the whole list is shown. Package columns, items, sorting and plugin settings are still updated. Clear this option to use package list defaults."/>
        </Grid>
        <Border x:Name="DownloadActivityPanel" Grid.Row="2" Margin="0,0,0,8" Padding="10,6"
                BorderBrush="{DynamicResource ApplicationUpdateText}" BorderThickness="3,0,0,0" Background="{DynamicResource RowAltBg}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="DownloadStageText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,3"
                               Visibility="Collapsed" AutomationProperties.Name="Current GNG operation"/>
                    <TextBox x:Name="StatusText" Text="Choose Download Swedish GNG or Import ZIP to begin. Opening this window does not start a download."
                             IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" MaxHeight="75" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource PrimaryText}" Padding="0" AutomationProperties.Name="GNG operation status" AutomationProperties.LiveSetting="Polite"/>
                    <ProgressBar x:Name="Activity" Height="7" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,7,0,0"
                                 Foreground="{DynamicResource ApplicationUpdateText}" AutomationProperties.Name="GNG operation progress"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button x:Name="StopRequestButton" Content="Stop" Click="StopRequest_Click" IsEnabled="False" Visibility="Collapsed"
                            ToolTip="Stop waiting for sign-in or the next package download."/>
                    <Button x:Name="CancelDownloadButton" Content="Cancel download" Click="CancelDownload_Click" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="3" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Background="{DynamicResource RowBg}">
            <Grid>
                <Grid x:Name="BrowserPanel">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid x:Name="BrowserToolbar" Visibility="Collapsed" Margin="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <WrapPanel>
                            <Button x:Name="BackButton" Content="←" Click="Back_Click" ToolTip="Go back" AutomationProperties.Name="Go back" IsEnabled="False" Margin="0,0,6,0"/>
                            <Button x:Name="ReloadButton" Content="Reload" Click="Reload_Click" IsEnabled="False" Margin="0,0,6,0"/>
                            <Button x:Name="HomeButton" Content="AeroNav" Click="Home_Click" IsEnabled="False" Margin="0,0,12,0"/>
                            <Button x:Name="RetryDownloadButton" Content="Retry download" Click="RetryDownload_Click" IsEnabled="False" Margin="0,0,6,0"/>
                        </WrapPanel>
                        <TextBlock x:Name="OriginText" Grid.Row="1" Text="Browser not started" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}" AutomationProperties.Name="Current website origin"/>
                    </Grid>
                    <Grid x:Name="BrowserSurface" Grid.Row="1">
                        <ContentControl x:Name="BrowserHost"/>
                    </Grid>
                    <Border x:Name="StartPanel" Grid.Row="1" Background="{DynamicResource RowBg}" Padding="20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel VerticalAlignment="Center" MaxWidth="650">
                                <TextBlock x:Name="StartHeading" Text="Get your GNG package" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="StartExplanation" Text="Launchpad checks AeroNav's current version and matching saved packages first, then downloads what is missing. Sign in if asked. You review the changes before installing; your website sign-in stays in this browser."
                                           TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,10,0,12"/>
                                <TextBlock x:Name="PackageKindText" TextWrapping="Wrap" Margin="0,0,0,12" FontWeight="SemiBold"/>
                                <WrapPanel>
                                    <Button x:Name="StartBrowserButton" Content="Download Swedish GNG" Click="StartBrowser_Click" Margin="0,0,8,8"
                                            ToolTip="Check AeroNav's current version and reuse matching saved packages first. Download missing packages, then review before installing."/>
                                    <Button x:Name="FreshDownloadButton" Content="Download fresh copies" Click="FreshDownload_Click" Margin="0,0,8,8"
                                            FontSize="11" Padding="10,5" Foreground="{DynamicResource SecondaryText}"
                                            ToolTip="Ignore saved packages and download fresh copies from AeroNav. Installation still requires your review."/>
                                    <Button x:Name="RuntimeInstallButton" Content="Install WebView2…" Click="InstallRuntime_Click" Visibility="Collapsed" Margin="0,0,8,8"/>
                                    <Button x:Name="RuntimeInfoButton" Content="Runtime information ↗" Click="RuntimeInfo_Click" Visibility="Collapsed" Margin="0,0,0,8"/>
                                </WrapPanel>
                                <TextBlock Text="Launchpad checks the package against your data folder before showing the installation review. Nothing is installed automatically."
                                           TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,8,0,0"/>
                                <TextBlock Text="Already downloaded it? Choose Import ZIP below. Keep the original AeroNav filename. If sign-in does not work here, use your normal browser and import the ZIP."
                                           TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <Grid x:Name="BrowserDownloadOverlay" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource RowAltBg}"
                          AutomationProperties.Name="Website controls locked during download or package checks">
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Padding="20,16"
                                MaxWidth="460" Background="{DynamicResource RowBg}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock x:Name="BrowserOverlayTitle" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Text, ElementName=DownloadStageText}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=DownloadStageText}" Value="">
                                                    <Setter Property="Text" Value="Preparing your package"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock x:Name="BrowserOverlayHint" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource SecondaryText}" Margin="0,8,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Progress is shown above. Website controls are unavailable during this step."/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=CancelDownloadButton}" Value="Visible">
                                                    <Setter Property="Text" Value="Progress is shown above. You can cancel the download there."/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=StopRequestButton}" Value="Visible">
                                                    <Setter Property="Text" Value="Progress is shown above. You can stop this request there."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
                <Grid x:Name="ReviewPanel" Visibility="Collapsed" Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <Button x:Name="ChooseAnotherButton" DockPanel.Dock="Right" Content="Choose another package" Click="ChooseAnother_Click" Margin="12,0,0,0" VerticalAlignment="Top"/>
                        <StackPanel>
                            <TextBlock x:Name="PackageText" TextWrapping="Wrap" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PackageSummaryText" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBox x:Name="WarningsText" Grid.Row="1" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="60"
                             Background="{DynamicResource RowAltBg}" Foreground="{DynamicResource PrimaryText}" Padding="8" Margin="0,0,0,8" AutomationProperties.Name="Installation review and backup location"/>
                    <DockPanel Grid.Row="2" Margin="0,0,0,6">
                        <CheckBox x:Name="ShowUnchangedFiles" DockPanel.Dock="Right" Content="Show unchanged files"
                                  Checked="ReviewFilterChanged" Unchecked="ReviewFilterChanged" Margin="12,0,0,0"
                                  Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"
                                  ToolTip="Also show files that already match and personal files that will be kept. This does not change what will be installed."/>
                        <TextBlock x:Name="FileSummaryText" TextWrapping="Wrap" VerticalAlignment="Center"
                                   AutomationProperties.Name="GNG file change counts"/>
                    </DockPanel>
                    <Grid Grid.Row="3">
                        <DataGrid x:Name="FilesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                  CanUserReorderColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="{DynamicResource RowBg}" Foreground="{DynamicResource PrimaryText}"
                                  RowBackground="{DynamicResource RowBg}" AlternatingRowBackground="{DynamicResource RowAltBg}" HorizontalGridLinesBrush="{DynamicResource DividerBrush}" BorderThickness="0"
                                  MouseDoubleClick="FilesGrid_MouseDoubleClick" SelectionMode="Single"
                                  AutomationProperties.Name="Proposed GNG file changes">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="115" ElementStyle="{StaticResource FileText}"/>
                                <DataGridTextColumn Header="File" Binding="{Binding RelativePath}" Width="2*" ElementStyle="{StaticResource FileText}"/>
                                <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="3*" ElementStyle="{StaticResource FileText}"/>
                                <DataGridTemplateColumn Header="Changes" Width="76">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="View…" Click="ViewFileChanges_Click" Padding="7,2" Margin="4"
                                                    ToolTip="Compare the current file with the result after installation."
                                                    AutomationProperties.Name="{Binding RelativePath, StringFormat=View changes to {0}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="NoFileChangesText" Visibility="Collapsed" TextWrapping="Wrap" Margin="8" VerticalAlignment="Center"
                                   Text="No files will be changed. Show unchanged files to see what already matches or will be kept."/>
                    </Grid>
                    <CheckBox x:Name="ConfirmInstall" Grid.Row="4" Checked="ConfirmationChanged" Unchecked="ConfirmationChanged" Margin="0,10,0,0" Foreground="{DynamicResource PrimaryText}">
                        <TextBlock Text="I have reviewed the changes and destination folder. EuroScope is closed." TextWrapping="Wrap"/>
                    </CheckBox>
                </Grid>
                <ScrollViewer x:Name="CompletePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="20">
                    <StackPanel>
                        <TextBlock x:Name="CompleteTitle" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBox x:Name="CompleteText" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="135"
                                 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryText}" Margin="0,10,0,14" AutomationProperties.Name="Installation or restore result"/>
                        <TextBlock Text="Keep your recovery backup" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="BackupText" IsReadOnly="True" TextWrapping="Wrap" Padding="7" AutomationProperties.Name="GNG update backup location"/>
                        <TextBlock Text="Restore backup can undo this installation. Files changed afterward are kept for your review. Read the package release notes before starting EuroScope."
                                   TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,8,0,14"/>
                        <TextBlock x:Name="CleanupHint" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}"/>
                        <Button x:Name="CleanupButton" Content="Review old files for cleanup…" Click="Cleanup_Click" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock x:Name="EuroScopeNotice" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,8"
                       Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold"
                       AutomationProperties.Name="EuroScope must be closed" AutomationProperties.LiveSetting="Polite"/>
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="StartOverButton" Content="Start over" Click="StartOver_Click" Visibility="Collapsed" Margin="0,0,8,0"/>
                <Button x:Name="ImportButton" Content="Import ZIP…" Click="Import_Click" Margin="0,0,8,0"/>
                <Button x:Name="ExternalBrowserButton" Content="Open in browser ↗" Click="ExternalBrowser_Click" Margin="0,0,8,0"/>
                <Button x:Name="RestoreButton" Content="Restore backup…" Click="Restore_Click" Margin="0,0,8,0"/>
                <Button x:Name="InstallButton" Content="Install reviewed package" Click="Install_Click" IsEnabled="False" Visibility="Collapsed" Margin="0,0,8,0"/>
                <Button x:Name="CloseButton" Content="Close" Click="Close_Click" IsCancel="True"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
