<UserControl x:Class="VatscaUpdateChecker.ActivityWorkspaceControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Foreground="{DynamicResource PrimaryText}" Background="{DynamicResource AppBg}" FontSize="{DynamicResource TextSize12}">
 <UserControl.Resources>
  <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource ThemedButton}"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="8,4"/><Setter Property="Margin" Value="0,0,6,4"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource ColumnHeaderBg}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="Padding" Value="8"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="Padding" Value="6"/><Setter Property="BorderBrush" Value="Transparent"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource ApplicationSelectedBg}"/></Trigger></Style.Triggers></Style>
  <Style x:Key="CellText" TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/></Style>
 </UserControl.Resources>
 <Grid Margin="12,10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="80"/><RowDefinition Height="6"/><RowDefinition Height="*" MinHeight="70"/></Grid.RowDefinitions>
  <TextBlock x:Name="HistoryNotice" Text="Recent installs, updates and recovery actions on this PC." TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{DynamicResource ApplicationSecondaryText}"/>
  <DataGrid x:Name="HistoryGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" CanUserSortColumns="False" HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="History_SelectionChanged" Background="{DynamicResource RowBg}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource DividerBrush}" RowBackground="{DynamicResource RowBg}" AlternatingRowBackground="{DynamicResource RowAltBg}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource DividerBrush}" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Recent activity, newest first">
   <DataGrid.Columns>
    <DataGridTextColumn Header="When" Binding="{Binding DisplayTime}" Width="Auto" MinWidth="135" ElementStyle="{StaticResource CellText}"/>
    <DataGridTextColumn Header="Application" Binding="{Binding ApplicationName}" Width="*" MinWidth="125" ElementStyle="{StaticResource CellText}"/>
    <DataGridTextColumn Header="Action" Binding="{Binding OperationName}" Width="120" ElementStyle="{StaticResource CellText}"/>
    <DataGridTextColumn Header="Result" Binding="{Binding OutcomeName}" Width="115" ElementStyle="{StaticResource CellText}"/>
    <DataGridTextColumn Header="Version" Binding="{Binding VersionChange}" Width="*" MinWidth="110" ElementStyle="{StaticResource CellText}"/>
   </DataGrid.Columns>
  </DataGrid>
  <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="{DynamicResource DividerBrush}" ResizeDirection="Rows" AutomationProperties.Name="Resize activity details"/>
  <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="0,8,0,0">
    <TextBlock x:Name="SelectionHeading" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock x:Name="SelectionGuidance" TextWrapping="Wrap" Margin="0,5,0,8" Foreground="{DynamicResource ApplicationSecondaryText}"/>
    <TextBox x:Name="RecoveryPath" IsReadOnly="True" Visibility="Collapsed" Background="{DynamicResource InputBg}" Foreground="{DynamicResource InputFg}" BorderBrush="{DynamicResource InputBorder}" Padding="6" Margin="0,0,0,8" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Recovery folder"/>
    <WrapPanel><Button x:Name="OpenRecoveryButton" Content="Open recovery folder" Style="{StaticResource Action}" Click="OpenRecovery_Click" Visibility="Collapsed"/><Button x:Name="GngRecoveryButton" Content="Review restore…" Style="{StaticResource Action}" Click="GngRecovery_Click" Visibility="Collapsed"/><Button x:Name="ReportButton" Content="Report a problem…" Style="{StaticResource Action}" Click="Report_Click" Visibility="Collapsed"/></WrapPanel>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</UserControl>
