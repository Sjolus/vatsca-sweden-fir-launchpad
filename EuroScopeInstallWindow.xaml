<Window x:Class="VatscaUpdateChecker.EuroScopeInstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage EuroScope" Width="790" Height="700" MinWidth="580" MinHeight="450"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBg}" Foreground="{DynamicResource PrimaryText}">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="EuroScope for the Swedish GNG package" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="SupportedText" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,6"/>
            <TextBlock Text="Install, repair, or switch to the supported token-authentication build. Review the proposed change first. EuroScope stays closed and no newer release is chosen automatically."
                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <ProgressBar x:Name="Activity" Height="6" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,0,0,8"/>
            <TextBox x:Name="StatusText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="100" VerticalScrollBarVisibility="Auto"
                     BorderThickness="0" Background="Transparent" Foreground="{DynamicResource PrimaryText}"
                     AutomationProperties.Name="EuroScope installation status"/>
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="ReviewButton" Content="Review change" Click="Review_Click" Padding="12,8" Margin="0,0,8,0"/>
                <Button x:Name="ApplyButton" Content="Apply reviewed change" Click="Apply_Click" IsEnabled="False"
                        Padding="12,8" Margin="0,0,8,0" Background="#1a475f" Foreground="White"/>
                <Button x:Name="CancelOperationButton" Content="Cancel preparation" Click="CancelOperation_Click" Visibility="Collapsed" Padding="12,8" Margin="0,0,8,0"/>
                <Button x:Name="CloseButton" Content="Close" Click="Close_Click" IsCancel="True" Padding="12,8"/>
            </WrapPanel>
        </StackPanel>
        <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <StackPanel x:Name="OptionsPanel">
                    <TextBlock x:Name="ConfiguredPath" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,12"/>
                    <TextBlock Text="Recovery folder" FontWeight="SemiBold"/>
                    <TextBlock Text="Required when existing files may change. Choose a private folder outside your EuroScope installation and data; exports may contain profile passwords."
                               TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,8"/>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="Choose folder…" Click="ChooseBackup_Click" Padding="10,6" Margin="8,0,0,0"/>
                        <TextBox x:Name="BackupPath" IsReadOnly="True" Padding="6" AutomationProperties.Name="Recovery folder"/>
                    </DockPanel>
                    <WrapPanel Margin="0,0,0,12">
                        <Button Content="Find existing installations…" Click="Adopt_Click" Padding="10,6" Margin="0,0,8,6"/>
                        <Button Content="Supported release notes ↗" Click="ReleaseNotes_Click" Padding="10,6" Margin="0,0,8,6"/>
                        <Button x:Name="PrerequisiteButton" Content="Check Visual C++ requirement" Click="Prerequisite_Click" Padding="10,6" Margin="0,0,8,6"/>
                        <Button Content="Remove apps / settings…" Click="Removal_Click" Padding="10,6" Margin="0,0,0,6"/>
                    </WrapPanel>
                </StackPanel>
                <StackPanel x:Name="ReviewPanel" Margin="0,8,0,0">
                    <TextBlock Text="Review" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBox x:Name="ReviewText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="210"
                             VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Reviewed EuroScope change"
                             Background="{DynamicResource RowBg}" Foreground="{DynamicResource PrimaryText}" Padding="12"
                             Text="Choose a recovery folder if needed, then review the proposed change. Nothing is downloaded or installed by a version check."/>
                    <CheckBox x:Name="ConfirmChange" IsEnabled="False" Checked="ConfirmationChanged" Unchecked="ConfirmationChanged"
                              Foreground="{DynamicResource PrimaryText}" Margin="0,10,0,8"
                              AutomationProperties.Name="Confirm the reviewed version, destination and recovery plan">
                        <TextBlock Text="I reviewed the version, destination and recovery plan." TextWrapping="Wrap"/>
                    </CheckBox>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
