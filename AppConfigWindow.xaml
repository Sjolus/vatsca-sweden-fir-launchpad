<Window x:Class="VatscaUpdateChecker.AppConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VatscaUpdateChecker"
        Title="Controller profile" Height="720" Width="560" MinHeight="400" MinWidth="440"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}" FontSize="{DynamicResource TextSize12}">
    <DockPanel Margin="20">
        <Button Content="Cancel" DockPanel.Dock="Bottom" HorizontalAlignment="Right" MinWidth="80"
                Click="Cancel_Click" IsCancel="True" Padding="0,7" Margin="0,10,0,0"/>
        <local:ControllerProfileControl x:Name="ProfileEditor"/>
    </DockPanel>
</Window>
