<Window x:Class="VatscaUpdateChecker.EuroScopeLaunchSetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EuroScope launch sets" Icon="Assets/app.ico" Width="860" Height="560"
        MinWidth="620" MinHeight="400" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}" Foreground="{DynamicResource PrimaryText}"
        FontSize="{DynamicResource TextSize12}">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="EuroScope launch sets" FontSize="{DynamicResource TextSize22}" FontWeight="SemiBold"/>
            <TextBlock Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,7,0,0"
                       Text="Each set starts its enabled instances in order. Each instance after the first waits until the previous EuroScope window has opened, then for its optional extra wait. Choose which set Launch uses here or from the EuroScope ▾ menu."/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="ValidationText" Foreground="{DynamicResource ApplicationWarningText}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="Save" Click="Save_Click" IsDefault="True" MinWidth="80" Margin="0,0,8,0"/>
                <Button Content="Cancel" IsCancel="True" MinWidth="80"/>
            </WrapPanel>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <!-- Sets -->
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Sets" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,4"/>
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button Content="New set" Click="NewSet_Click" x:Name="NewSetButton" MinWidth="70" Margin="0,0,6,4"/>
                    <Button Content="Duplicate" Click="DuplicateSet_Click" x:Name="DuplicateSetButton" MinWidth="70" Margin="0,0,6,4"/>
                    <Button Content="Delete" Click="DeleteSet_Click" x:Name="DeleteSetButton" MinWidth="60" Margin="0,0,0,4"/>
                </WrapPanel>
                <ListBox x:Name="SetList" SelectionChanged="SetList_SelectionChanged" AutomationProperties.Name="Launch sets"
                         Background="{DynamicResource InputBg}" Foreground="{DynamicResource InputFg}" BorderBrush="{DynamicResource InputBorder}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,3">
                                <TextBlock Text="{Binding ListLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding ListDetail}" FontSize="{DynamicResource TextSize11}" Opacity="0.75"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Selected set -->
            <TextBlock x:Name="NoSetText" Grid.Column="2" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap"
                       Text="No launch sets yet. Choose New set to create one."/>
            <DockPanel x:Name="SetEditor" Grid.Column="2">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Name" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="NameBox" Grid.Column="1" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="40" VerticalContentAlignment="Center" Padding="4,3" AutomationProperties.Name="Launch set name"/>
                    <CheckBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" IsChecked="{Binding IsActive, Mode=TwoWay}" Foreground="{DynamicResource PrimaryText}"
                              Content="Use this set when pressing Launch"/>
                </Grid>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/><ColumnDefinition Width="104"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="#" Foreground="{DynamicResource SecondaryText}"/>
                    <TextBlock Grid.Column="1" Text="On" Foreground="{DynamicResource SecondaryText}"/>
                    <TextBlock Grid.Column="2" Text="Profile" Foreground="{DynamicResource SecondaryText}"/>
                    <TextBlock Grid.Column="3" Text="Extra wait (s)" Foreground="{DynamicResource SecondaryText}"/>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <ItemsControl x:Name="EntryList" ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/><ColumnDefinition Width="104"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding OrderText}" VerticalAlignment="Center"/>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center"
                                                      AutomationProperties.Name="{Binding OrderText, StringFormat=Enable instance {0}}"/>
                                            <!-- Explicit template: the themed ComboBox shows SelectionBoxItemTemplate, which DisplayMemberPath leaves unset. -->
                                            <ComboBox Grid.Column="2" Margin="0,0,8,0" TextSearch.TextPath="DisplayName"
                                                      ItemsSource="{Binding Profiles, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding Profile, Mode=TwoWay}"
                                                      ToolTip="{Binding Profile.FilePath}"
                                                      AutomationProperties.Name="{Binding OrderText, StringFormat=Profile for instance {0}}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBox Grid.Column="3" Margin="0,0,8,0" Text="{Binding DelayText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     VerticalContentAlignment="Center" IsEnabled="{Binding DelayApplies}"
                                                     AutomationProperties.Name="{Binding OrderText, StringFormat=Extra wait in seconds before instance {0}}"/>
                                            <StackPanel Grid.Column="4" Orientation="Horizontal">
                                                <Button Content="↑" Click="Up_Click" Width="30" Margin="0,0,4,0" ToolTip="Move up"
                                                        AutomationProperties.Name="{Binding OrderText, StringFormat=Move instance {0} up}"/>
                                                <Button Content="↓" Click="Down_Click" Width="30" Margin="0,0,4,0" ToolTip="Move down"
                                                        AutomationProperties.Name="{Binding OrderText, StringFormat=Move instance {0} down}"/>
                                                <Button Content="✕" Click="Remove_Click" Width="30" ToolTip="Remove"
                                                        AutomationProperties.Name="{Binding OrderText, StringFormat=Remove instance {0}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="EmptyText" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="No instances in this set yet."/>
                        <Button x:Name="AddButton" Content="+ Add instance" Click="Add_Click" HorizontalAlignment="Left"
                                MinWidth="110" Margin="0,8,0,0" AutomationProperties.Name="Add instance to this set"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
