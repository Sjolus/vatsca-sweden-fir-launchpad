<Window x:Class="VatscaUpdateChecker.ReportingHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Last sent reports" Icon="Assets/app.ico" Width="720" Height="660"
        MinWidth="460" MinHeight="420" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}" Foreground="{DynamicResource PrimaryText}"
        FontSize="{DynamicResource TextSize12}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Last sent reports" FontSize="{DynamicResource TextSize22}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="Report type" Margin="0,10,0,5"/>
            <ComboBox x:Name="StreamChoice" DisplayMemberPath="Label" SelectionChanged="Stream_Changed"
                      AutomationProperties.Name="Report type"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="ActionStatus" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8"/>
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="RefreshButton" Content="Refresh" Click="Refresh_Click" Margin="0,0,8,4"
                        ToolTip="Read the latest saved copies on this PC. This does not contact the reporting service."/>
                <Button x:Name="CloseButton" Content="Close" IsCancel="True" MinWidth="80" Margin="0,0,0,4"/>
            </WrapPanel>
        </StackPanel>
        <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock x:Name="DeliveryStatus" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="PendingStatus" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <TextBlock x:Name="ConsentStatus" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                <TextBlock x:Name="EmptyStatus" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <StackPanel x:Name="DeliveryPanel" Visibility="Collapsed">
                    <Expander x:Name="JsonDetails" Header="Exact data sent (JSON)" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,12">
                        <StackPanel Margin="0,6,0,0">
                            <TextBlock Text="The JSON below is formatted for reading. Copy JSON copies the original request exactly."
                                       Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBox x:Name="JsonText" IsReadOnly="True" IsReadOnlyCaretVisible="True" FontFamily="Consolas"
                                     FontSize="{DynamicResource TextSize11}" TextWrapping="NoWrap" Height="260"
                                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="Exact JSON of the last confirmed send"/>
                            <Button x:Name="CopyJsonButton" Content="Copy JSON" Click="CopyJson_Click"
                                    HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Expander>
                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Information sent" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="ReadableReportText" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                     BorderThickness="0" Padding="0" TextWrapping="Wrap"
                                     Background="{DynamicResource AppBg}" Foreground="{DynamicResource PrimaryText}"
                                     AutomationProperties.Name="Readable summary of the last confirmed send"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Text="Only the latest confirmed send of each type is kept on this PC. Earlier sends are not listed."
                           Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
