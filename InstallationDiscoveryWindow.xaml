<Window x:Class="VatscaUpdateChecker.InstallationDiscoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose installed ATC programs and folders" Width="780" Height="610" MinWidth="640" MinHeight="430"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBg}" Foreground="{DynamicResource PrimaryText}">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="Which programs and folders do you use?" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="These results come from installed-app records and usual locations on this PC. Choose your programs and, separately, the folders holding Swedish GNG data or the VatEFS plugin. Next, review and Save them in Settings. Nothing is installed, moved or started."
                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,8,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <CheckBox x:Name="ReplaceConfigured" Content="Replace my existing choices with the selected locations" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,8"/>
            <TextBlock x:Name="ResultText" Text="Checking which results look like the right programs and folders…" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" AutomationProperties.LiveSetting="Polite"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="UseButton" Content="Review selected locations" Padding="14,8" Margin="0,0,8,0" Background="#1a475f" Foreground="White" Click="Use_Click"/>
                <Button Content="Cancel" Padding="14,8" IsCancel="True" Click="Cancel_Click"/>
            </StackPanel>
        </StackPanel>
        <ScrollViewer x:Name="DiscoveryResults" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="CandidatesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource RowBg}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <CheckBox Content="{Binding Candidate.AppName}" IsChecked="{Binding Selected}" IsEnabled="{Binding CanSelect}" Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text="{Binding LocationKind}" TextWrapping="Wrap" Margin="20,4,0,0" Foreground="{DynamicResource SecondaryText}"/>
                                <TextBlock Text="{Binding Path}" TextWrapping="Wrap" Margin="20,6,0,4"/>
                                <TextBlock Text="{Binding VerificationText}" TextWrapping="Wrap" Foreground="{Binding VerificationBrush}" Margin="20,0,0,4" AutomationProperties.LiveSetting="Polite"/>
                                <TextBlock Text="{Binding SupportText}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="20,0,0,0"/>
                                <TextBlock Text="{Binding ScopeLabel}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="20,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
