<Window x:Class="VatscaUpdateChecker.InstallationDiscoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Installed applications" Width="780" Height="590" MinWidth="580" MinHeight="430"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBg}" Foreground="{DynamicResource PrimaryText}" FontSize="{DynamicResource TextSize12}">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Installed applications" FontSize="{DynamicResource TextSize22}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="Current locations are already kept. Select a different copy only when you want to change it."
                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="ResultText" Text="Checking the files and folders…" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" AutomationProperties.LiveSetting="Polite"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="UseButton" Content="Done" Padding="14,7" Margin="0,0,8,0" Background="#1a475f" Foreground="White" Click="Use_Click"/>
                <Button Content="Cancel" Padding="14,7" IsCancel="True" Click="Cancel_Click"/>
            </StackPanel>
        </StackPanel>
        <ScrollViewer x:Name="DiscoveryResults" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="CandidatesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource RowBg}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <WrapPanel Margin="0,0,8,5" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Candidate.AppName}" FontWeight="SemiBold" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding StateLabel}" Foreground="{DynamicResource SecondaryText}"/>
                                </WrapPanel>
                                <Button Grid.Column="1" Grid.RowSpan="2" Content="{Binding ActionText}" IsEnabled="{Binding CanChoose}" Click="Choose_Click" Padding="9,6" Margin="8,0,0,0" VerticalAlignment="Top"
                                        AutomationProperties.Name="{Binding Candidate.AppName, StringFormat='Change location for {0}'}"/>
                                <TextBlock Grid.Row="1" Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" Foreground="{DynamicResource SecondaryText}"/>
                                <Expander Grid.Row="2" Grid.ColumnSpan="2" Header="{Binding DetailsLabel}" Foreground="{DynamicResource PrimaryText}" Margin="0,5,0,0">
                                    <StackPanel Margin="0,5,0,0">
                                        <TextBlock Text="{Binding Path}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding VerificationText}" TextWrapping="Wrap" Foreground="{Binding VerificationBrush}" AutomationProperties.LiveSetting="Polite"/>
                                        <TextBlock Text="{Binding LocationKind}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding ScopeLabel}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}"/>
                                        <TextBlock Text="{Binding SupportText}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Expander>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
