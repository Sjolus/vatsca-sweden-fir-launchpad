<Window x:Class="VatscaUpdateChecker.ReportingPreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Privacy and support" Icon="Assets/app.ico" Width="620" Height="720"
        MinWidth="440" MinHeight="420" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}" Foreground="{DynamicResource PrimaryText}"
        FontSize="{DynamicResource TextSize12}">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,15">
            <TextBlock x:Name="Heading" Text="Privacy and support" FontSize="{DynamicResource TextSize22}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="Help improve setup and updates. You choose what Launchpad sends."
                       Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="{DynamicResource WarningFg}"
                       AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8"/>
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="SaveChoices" Content="Save choices" Click="Save_Click" IsDefault="True" Margin="0,0,8,4"/>
                <Button x:Name="DismissButton" Content="Cancel" IsCancel="True" MinWidth="80" Margin="0,0,0,4"/>
            </WrapPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <CheckBox x:Name="UsageChoice" Foreground="{DynamicResource PrimaryText}">
                    <TextBlock Text="Share usage statistics" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </CheckBox>
                <TextBlock Margin="22,5,0,14" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap"
                           Text="Launchpad sessions and version, features used, application launch actions, setup choices and display preferences. No ATC activity or time spent controlling."/>
                <CheckBox x:Name="InventoryChoice" Foreground="{DynamicResource PrimaryText}">
                    <TextBlock Text="Share software and plugin versions" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </CheckBox>
                <TextBlock Margin="22,5,0,14" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap"
                           Text="Versions of configured ATC applications, the Swedish GNG package and recognised EuroScope plugins, read during normal version checks. Unknown versions stay unknown. No file paths, profile contents or DLL contents are sent. This works independently of usage and errors."/>
                <CheckBox x:Name="ErrorsChoice" Foreground="{DynamicResource PrimaryText}">
                    <TextBlock Text="Send automatic error reports" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </CheckBox>
                <TextBlock Margin="22,5,0,14" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap"
                           Text="Limited technical details when something fails: Launchpad version, application, action and error category. Software-version context is included only if version sharing is also enabled. This works without usage statistics."/>
                <TextBlock x:Name="ChoiceExplanation" TextWrapping="Wrap" Margin="0,0,0,14"/>
                <Expander Header="What is sent?" Margin="0,0,0,16">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock TextWrapping="Wrap" Text="Reports include a random support ID, Launchpad version, selected application, action, outcome and time. Error reports use fixed technical categories. Names, CID, passwords, Hoppie codes, file paths, profiles and browser sign-in data are excluded."/>
                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Text="Data is sent to launchpad.space.sjolus.org. The support ID links reports from this installation; it is not your VATSIM identity. Turning reporting off clears unsent reports for that category. Reports already received are kept according to the service's retention policy."/>
                        <Button Content="Read reporting privacy details ↗" Click="Privacy_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    </StackPanel>
                </Expander>
                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Your support ID" FontWeight="SemiBold"/>
                        <TextBlock Text="Share this ID with the maintainer to help find your reports. It stays the same when Launchpad updates."
                                   TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,5,0,8"/>
                        <TextBox x:Name="SupportIdText" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap"
                                 AutomationProperties.Name="Support ID"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button x:Name="CopyIdButton" Content="Copy support ID" Click="CopyId_Click" Margin="0,0,8,6"/>
                            <Button x:Name="ResetIdButton" Content="Generate new support ID…" Click="ResetId_Click" Margin="0,0,0,6"/>
                        </WrapPanel>
                        <Button x:Name="ClearPendingButton" Content="Clear unsent reports" Click="ClearPending_Click" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="PendingText" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
