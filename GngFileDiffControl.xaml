<UserControl x:Class="VatscaUpdateChecker.GngFileDiffControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource AppBg}" Foreground="{DynamicResource PrimaryText}" FontSize="{DynamicResource TextSize12}">
    <UserControl.Resources>
        <Style x:Key="PreviewText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="True"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="{DynamicResource TextSize13}"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Padding="12,7" Background="{DynamicResource RowAltBg}"
                                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Margin="0,0,4,0">
                            <ContentPresenter x:Name="TabHeader" ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ApplicationSelectedBg}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource ApplicationUpdateText}"/>
                                <Setter TargetName="TabHeader" Property="TextElement.FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource ButtonFocusBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition x:Name="HeaderRow" Height="Auto"/><RowDefinition x:Name="BodyRow" Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBox x:Name="FilePathText" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="NoWrap"
                     FontWeight="SemiBold" FontSize="{DynamicResource TextSize15}" BorderThickness="0" Padding="0"
                     Background="Transparent" Foreground="{DynamicResource PrimaryText}" HorizontalScrollBarVisibility="Hidden"
                     AutomationProperties.Name="File within the GNG package"/>
            <DockPanel Grid.Row="1" Margin="0,5,0,0">
                <TextBlock x:Name="FilePositionText" DockPanel.Dock="Right" Foreground="{DynamicResource SecondaryText}" Margin="10,0,0,0"/>
                <TextBlock x:Name="ActionText" Foreground="{DynamicResource SecondaryText}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Grid>
        <TabControl x:Name="PreviewTabs" Grid.Row="1" Background="{DynamicResource AppBg}" BorderBrush="{DynamicResource DividerBrush}" Padding="4"
                    AutomationProperties.Name="File preview views">
            <TabItem x:Name="ChangesTab" Header="Changes" IsSelected="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,6">
                        <Button x:Name="NextChangeButton" DockPanel.Dock="Right" Content="Next change ↓" Click="NextChange_Click" IsEnabled="False"
                                Margin="8,0,0,0" ToolTip="Jump to the next group of changed lines."/>
                        <TextBlock x:Name="ChangePositionText" DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryText}" AutomationProperties.Name="Current change group"/>
                        <TextBlock x:Name="DiffSummaryText" Foreground="{DynamicResource SecondaryText}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" AutomationProperties.Name="Text difference summary"/>
                    </DockPanel>
                    <RichTextBox x:Name="DiffText" Grid.Row="1" IsReadOnly="True" IsReadOnlyCaretVisible="True" FontFamily="Consolas" FontSize="{DynamicResource TextSize13}"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="8"
                                 Background="{DynamicResource InputBg}" Foreground="{DynamicResource InputFg}" BorderBrush="{DynamicResource InputBorder}"
                                 AutomationProperties.Name="Expected text changes, additions marked plus and removals marked minus"/>
                </Grid>
            </TabItem>
            <TabItem x:Name="BeforeAfterTab" Header="Before / After">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Current file" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Grid.Column="2" Text="After installation" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="CurrentText" Grid.Row="1" Style="{StaticResource PreviewText}" AutomationProperties.Name="Current file text, sensitive values masked"/>
                    <TextBox x:Name="AfterText" Grid.Row="1" Grid.Column="2" Style="{StaticResource PreviewText}" AutomationProperties.Name="File text after installation, sensitive values masked"/>
                </Grid>
            </TabItem>
            <TabItem x:Name="InfoTab" Header="File information">
                <TextBox x:Name="SummaryText" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" Padding="8"
                         VerticalScrollBarVisibility="Auto" Background="{DynamicResource InputBg}" Foreground="{DynamicResource InputFg}"
                         AutomationProperties.Name="Expected change summary"/>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock x:Name="MaskingNotice" Text="Sensitive values are hidden." Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,6"/>
            <DockPanel>
                <Button x:Name="CloseButton" DockPanel.Dock="Left" Content="← Back to files" Click="Close_Click" HorizontalAlignment="Left" Margin="0,0,8,0"/>
                <StackPanel x:Name="FileNavigation" DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                    <Button x:Name="PreviousFileButton" Content="← Previous file" Click="PreviousFile_Click" Margin="0,0,8,0"/>
                    <Button x:Name="NextFileButton" Content="Next file →" Click="NextFile_Click"/>
                </StackPanel>
                <TextBlock x:Name="NavigationStatus" Text="Loading file…" Foreground="{DynamicResource SecondaryText}"
                           Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </DockPanel>
        </StackPanel>
    </Grid>
</UserControl>
