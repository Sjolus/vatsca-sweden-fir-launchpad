<Window x:Class="VatscaUpdateChecker.BulkApplicationActionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review applications" Icon="Assets/app.ico" Width="640" Height="540"
        MinWidth="440" MinHeight="440" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}" Foreground="{DynamicResource PrimaryText}"
        FontSize="{DynamicResource TextSize12}">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="Heading" FontSize="{DynamicResource TextSize22}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="Explanation" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,7,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="SelectionSummary" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,10"/>
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="ApplyButton" Click="Apply_Click" Margin="0,0,8,4"/>
                <Button Content="Cancel" IsCancel="True" IsDefault="True" MinWidth="80" Margin="0,0,0,4"/>
            </WrapPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ApplicationChoices">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}"
                                          AutomationProperties.Name="{Binding ApplicationName}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding ApplicationName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
