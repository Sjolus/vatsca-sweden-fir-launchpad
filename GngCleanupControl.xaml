<UserControl x:Class="VatscaUpdateChecker.GngCleanupControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource AppBg}" Foreground="{DynamicResource PrimaryText}"
        FontSize="{DynamicResource TextSize12}">
    <UserControl.Resources>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource ColumnHeaderBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ApplicationSelectedBg}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource ButtonFocusBorder}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" MaxHeight="230"/>
            <RowDefinition Height="3*" MinHeight="90"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
        <StackPanel>
            <TextBlock Text="Old package files" FontSize="{DynamicResource TextSize21}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="Select files to move into a recovery backup. Modified and referenced files stay in place."
                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,5,0,8"/>
        </StackPanel>
        <Expander x:Name="SourceDetails" Header="Package sources and backup" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,8">
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="140">
        <Grid x:Name="InputsPanel" Margin="0,6,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="144"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Label Content="EuroScope data folder" Target="{Binding ElementName=RootBox}" Foreground="{DynamicResource PrimaryText}" Padding="0,6,6,0"/>
            <TextBox x:Name="RootBox" Grid.Column="1" Grid.ColumnSpan="2" Padding="6" Margin="0,0,0,6" IsReadOnly="True"
                     AutomationProperties.Name="Configured EuroScope data folder" ToolTip="The folder saved under Setup. Go back to change it there."/>
            <Label Grid.Row="1" Content="_Old complete ZIP" Target="{Binding ElementName=OldZipBox}" Foreground="{DynamicResource PrimaryText}" Padding="0,6,6,0"/>
            <TextBox x:Name="OldZipBox" Grid.Row="1" Grid.Column="1" Padding="6" Margin="0,0,8,6" TextChanged="Inputs_Changed" AutomationProperties.Name="Old complete GNG ZIP package"/>
            <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Tag="Old" Margin="0,0,0,6" Click="BrowseZip_Click" AutomationProperties.Name="Browse for the old complete GNG ZIP package"/>
            <Label Grid.Row="2" Content="_New complete ZIP" Target="{Binding ElementName=NewZipBox}" Foreground="{DynamicResource PrimaryText}" Padding="0,6,6,0"/>
            <TextBox x:Name="NewZipBox" Grid.Row="2" Grid.Column="1" Padding="6" Margin="0,0,8,6" TextChanged="Inputs_Changed" AutomationProperties.Name="New complete GNG ZIP package"/>
            <Button Grid.Row="2" Grid.Column="2" Content="Browse…" Tag="New" Margin="0,0,0,6" Click="BrowseZip_Click" AutomationProperties.Name="Browse for the new complete GNG ZIP package"/>
            <Label Grid.Row="3" Content="Backup folder" Target="{Binding ElementName=BackupRootBox}" Foreground="{DynamicResource PrimaryText}" Padding="0,6,6,0"/>
            <TextBox x:Name="BackupRootBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Padding="6" Margin="0,0,0,6" IsReadOnly="True"
                     AutomationProperties.Name="Cleanup backup folder" ToolTip="Backups must be on the same local drive as your EuroScope data folder."/>
            <TextBlock Grid.Row="4" Grid.ColumnSpan="3" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,8">
                <Run Text="Use original Full Package ZIPs. Comparing changes nothing. "/>
                <Hyperlink x:Name="DownloadsLink" Click="Downloads_Click" Foreground="{DynamicResource ApplicationUpdateText}"
                           AutomationProperties.Name="Open Swedish GNG downloads on AeroNav in your browser">AeroNav downloads ↗</Hyperlink>
            </TextBlock>
        </Grid>
        </ScrollViewer>
        </Expander>
        <StackPanel>
            <WrapPanel Margin="0,0,0,5">
                <Button x:Name="CompareButton" Content="Compare packages" Click="Compare_Click" Margin="0,0,8,5"/>
                <Button x:Name="SelectButton" Content="Select available" IsEnabled="False" Click="SelectEligible_Click" Margin="0,0,8,5"/>
                <Button x:Name="ClearButton" Content="Clear selection" IsEnabled="False" Click="ClearSelection_Click" Margin="0,0,0,5"/>
            </WrapPanel>
            <TextBlock x:Name="SummaryText" Text="Choose the old and new Full Package ZIPs to compare." TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="1">
        <DataGrid x:Name="CandidatesGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserResizeRows="False" CanUserReorderColumns="False" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="Horizontal"
                  Background="{DynamicResource AppBg}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource DividerBrush}"
                  RowBackground="{DynamicResource RowBg}" AlternatingRowBackground="{DynamicResource RowAltBg}" HorizontalGridLinesBrush="{DynamicResource DividerBrush}"
                  AutomationProperties.Name="Old package files: select eligible files to move into a backup">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Move" Width="54">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEligible}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding Details}"
                                  AutomationProperties.Name="{Binding RelativePath, StringFormat=Move {0} to backup}"/>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="File" Width="3*" MinWidth="155">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <TextBlock Text="{Binding RelativePath}" TextWrapping="Wrap" Margin="6" ToolTip="{Binding RelativePath}"/>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="72" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Reason" Width="4*" MinWidth="180">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <TextBlock Text="{Binding Details}" TextWrapping="Wrap" Margin="6"/>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="EmptyText" Text="No old files need cleanup." Visibility="Collapsed" IsHitTestVisible="False"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="16"
                   Foreground="{DynamicResource SecondaryText}"/>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,9,0,0">
            <ProgressBar x:Name="Activity" Height="5" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,6" AutomationProperties.Name="GNG cleanup operation in progress"/>
            <TextBox x:Name="StatusText" Text="Nothing is selected. Backups keep using disk space."
                     IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="65" MinHeight="36"
                     BorderThickness="0" Background="Transparent" Foreground="{DynamicResource SecondaryText}" Padding="0" Margin="0,0,0,8"
                     AutomationProperties.Name="Cleanup result and recovery location" AutomationProperties.LiveSetting="Polite"/>
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="RestoreButton" Content="_Restore a backup…" Click="Restore_Click" Margin="0,0,8,0"/>
                <Button x:Name="ArchiveButton" Content="_Move selected to backup…" IsEnabled="False" Click="Archive_Click" Margin="0,0,8,0"/>
                <Button x:Name="CloseButton" Content="← Back" Click="Close_Click"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
</UserControl>
