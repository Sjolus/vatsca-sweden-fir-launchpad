<Window x:Class="VatscaUpdateChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:VatscaUpdateChecker.Models"
        xmlns:local="clr-namespace:VatscaUpdateChecker"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Icon="Assets/app.ico" Title="Sweden FIR Launchpad"
        Height="550" Width="880" Tag="Compact" MinHeight="480" MinWidth="760"
        ResizeMode="CanResize" WindowStyle="SingleBorderWindow" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Background="{DynamicResource AppBg}" FontSize="{DynamicResource TextSize12}" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="FlatButton" TargetType="Button" BasedOn="{StaticResource ThemedButton}">
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="#1a475f"/>
            <Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="{DynamicResource TextSize12}"/>
            <Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="9,4"/>
        </Style>
        <Style x:Key="RowActionButton" TargetType="Button" BasedOn="{StaticResource FlatButton}"/>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#b63f3f"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="RowShell" TargetType="Border">
            <Setter Property="Height" Value="{DynamicResource CompactRowHeight}"/>
            <Setter Property="Background" Value="{Binding IsEuroScopeChild, Converter={StaticResource RowBgConverter}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Window}}" Value="Comfortable"><Setter Property="Height" Value="{DynamicResource ExpandedRowHeight}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowStatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="FontSize" Value="{DynamicResource TextSize13}"/><Setter Property="FontWeight" Value="Medium"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RowStatusKind}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource ApplicationWarningText}"/></DataTrigger>
                <DataTrigger Binding="{Binding RowStatusKind}" Value="Update"><Setter Property="Foreground" Value="{DynamicResource ApplicationUpdateText}"/></DataTrigger>
                <DataTrigger Binding="{Binding RowStatusKind}" Value="Success"><Setter Property="Foreground" Value="{DynamicResource ApplicationSuccessText}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowExplanationText" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/><Setter Property="Foreground" Value="{DynamicResource ApplicationSecondaryText}"/>
            <Setter Property="FontSize" Value="{DynamicResource TextSize12}"/><Setter Property="Margin" Value="0,3,0,0"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Window}}" Value="Comfortable"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding HasGngTransfer}" Value="True"><Setter Property="Visibility" Value="Visible"/><Setter Property="Margin" Value="0"/><Setter Property="LineStackingStrategy" Value="BlockLineHeight"/><Setter Property="LineHeight" Value="{DynamicResource TextSize14}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LaunchButton" TargetType="Button" BasedOn="{StaticResource RowActionButton}">
            <Setter Property="Content" Value="{Binding LaunchActionText}"/><Setter Property="IsEnabled" Value="{Binding LaunchEnabled}"/>
            <Setter Property="Padding" Value="4,4"/><Setter Property="ToolTip" Value="{Binding LaunchTooltip}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding LaunchTooltip}"/>
        </Style>
        <Style x:Key="WorkspaceTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource ApplicationSecondaryText}"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="16,7"/>
            <Setter Property="FontSize" Value="{DynamicResource TextSize13}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" RecognizesAccessKey="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource ApplicationUpdateText}"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ApplicationSelectedBg}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource PrimaryText}"/><Setter TargetName="TabBorder" Property="BorderThickness" Value="1"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBg}" Padding="12,2" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="32"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <DockPanel VerticalAlignment="Center">
                    <Image DockPanel.Dock="Left" Source="Assets/logo-banner.png" Height="26" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Sweden FIR Launchpad" TextTrimming="CharacterEllipsis" ToolTip="Sweden FIR Launchpad" Foreground="White" FontSize="{DynamicResource TextSize16}" FontWeight="Light" VerticalAlignment="Center" Margin="12,0,8,0"/>
                </DockPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="AppConfigButton" Content="Controller profile" Visibility="Collapsed" Click="AppConfig_Click"/>
                    <Button x:Name="HelpButton" Content="?" Click="Help_Click" Style="{StaticResource FlatButton}" MinWidth="28" Padding="6,4" Margin="0,0,6,0"
                            ToolTip="Help, reporting and privacy" AutomationProperties.Name="Help, reporting and privacy"/>
                    <Button x:Name="ThemeToggleButton" Content="☽" Style="{StaticResource FlatButton}" FontSize="{DynamicResource TextSize14}" Margin="0,0,10,0"
                            ToolTip="Toggle dark / light mode" AutomationProperties.Name="Toggle dark or light theme" Click="ThemeToggle_Click"/>
                    <Button Content="─" Style="{StaticResource FlatButton}" Margin="0,0,2,0" ToolTip="Minimise" AutomationProperties.Name="Minimise Launchpad" Click="Minimize_Click"/>
                    <Button Content="□" Style="{StaticResource FlatButton}" Margin="0,0,2,0" ToolTip="Maximise or restore" AutomationProperties.Name="Maximise or restore Launchpad" Click="Maximize_Click"/>
                    <Button Content="✕" Style="{StaticResource CloseButton}" ToolTip="Close" AutomationProperties.Name="Close Launchpad" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Top" Background="{DynamicResource ColumnHeaderBg}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" KeyboardNavigation.DirectionalNavigation="Cycle">
                <RadioButton x:Name="AppsTab" Content="Apps" Tag="Apps" GroupName="Workspace" Style="{StaticResource WorkspaceTab}" Click="WorkspaceTab_Click"
                             IsChecked="True" AutomationProperties.Name="Applications tab" ToolTip="Launch applications and check for updates"/>
                <RadioButton x:Name="SetupTab" Content="Setup" Tag="Setup" GroupName="Workspace" Style="{StaticResource WorkspaceTab}" Click="WorkspaceTab_Click"
                             AutomationProperties.Name="Setup tab" ToolTip="Saved applications, GNG package and controller profile"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource FooterBg}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="12,7">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button x:Name="CheckButton" Content="↻  Check for updates" Style="{StaticResource FlatButton}" Click="Check_Click"/>
                <StackPanel x:Name="AppBulkActions" Grid.Column="1" Orientation="Horizontal" Margin="8,0">
                    <Button x:Name="StartAllButton" Content="Start all…" Click="StartAll_Click" Style="{StaticResource FlatButton}" Margin="0,0,5,0" IsEnabled="False" ToolTip="Choose which configured applications to start" AutomationProperties.Name="Review starting applications"/>
                    <Button x:Name="CloseAllButton" Content="Close all…" Click="CloseAll_Click" Style="{StaticResource FlatButton}" IsEnabled="False" ToolTip="Review which running applications to ask to close normally" AutomationProperties.Name="Review closing running applications"/>
                </StackPanel>
                <Button x:Name="MaintenanceButton" Grid.Column="3" Content="Remove / reset…" Margin="8,0" Style="{StaticResource FlatButton}"
                        Visibility="Collapsed"
                        ToolTip="Review software removal, optional settings resets and recovery copies" Click="Maintenance_Click"/>
                <TextBlock x:Name="ApplicationsSummary" Grid.Column="4" Text="Applications" Visibility="Collapsed"/>
                <TextBlock x:Name="LastCheckedText" Grid.Column="5" Text="Last checked: never" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{DynamicResource ApplicationSecondaryText}" FontSize="{DynamicResource TextSize12}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <Button x:Name="ActivityNoticeButton" Grid.Row="1" Grid.ColumnSpan="6" Visibility="{Binding Visibility, ElementName=ActivityNotice}" Click="Activity_Click"
                        Style="{StaticResource ThemedButton}" HorizontalContentAlignment="Left" Margin="0,5,0,0" Padding="4,3" Background="Transparent" BorderThickness="0"
                        ToolTip="Open activity and recovery" AutomationProperties.Name="{Binding Text, ElementName=ActivityNotice, StringFormat='Open activity and recovery: {0}'}">
                    <TextBlock x:Name="ActivityNotice" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryText}" AutomationProperties.LiveSetting="Polite"/>
                </Button>
                <TextBox x:Name="RestartNotice" Grid.Row="2" Grid.ColumnSpan="6" Visibility="Collapsed"
                         Text="An installer requested a Windows restart. Restart Windows before further setup, updates, removal or profile changes."
                         AutomationProperties.Name="Windows restart required" IsReadOnly="True" IsReadOnlyCaretVisible="True" IsTabStop="True"
                         TextWrapping="Wrap" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                         Background="{DynamicResource WarningBg}" Foreground="{DynamicResource WarningFg}" CaretBrush="{DynamicResource WarningFg}" BorderBrush="{DynamicResource WarningFg}"
                         FontSize="{DynamicResource TextSize12}" Margin="0,7,0,0" Padding="8,6"/>
            </Grid>
        </Border>
        <Grid>
        <DockPanel x:Name="AppsWorkspace">
        <Border x:Name="DiscoveryPrompt" DockPanel.Dock="Top" Background="{DynamicResource RowBg}" Padding="12,8" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Find existing apps…" Style="{StaticResource FlatButton}" Click="DiscoverInstallations_Click"/>
                <TextBlock Text="Open Setup to choose existing applications or install missing ones."
                           TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" Margin="0,0,12,0"/>
            </DockPanel>
        </Border>
        <ScrollViewer x:Name="ApplicationsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel MinWidth="{DynamicResource ApplicationTableMinWidth}" Width="{Binding ViewportWidth, ElementName=ApplicationsScroll}">
            <Border Background="{DynamicResource ColumnHeaderBg}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" MinHeight="28" Padding="0,3">
                <Grid Width="{Binding ActualWidth, ElementName=AppList}" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{DynamicResource LaunchColumnWidth}"/><ColumnDefinition Width="1.55*" MinWidth="146"/>
                        <ColumnDefinition Width="1.1*" MinWidth="104"/><ColumnDefinition Width="1.2*" MinWidth="122"/>
                        <ColumnDefinition Width="1.6*" MinWidth="142"/><ColumnDefinition Width="{DynamicResource OptionsColumnWidth}"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Controls" Margin="10,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource ApplicationSecondaryText}" FontSize="{DynamicResource TextSize12}"/>
                    <TextBlock Grid.Column="1" Text="Application" VerticalAlignment="Center" Foreground="{DynamicResource ApplicationSecondaryText}" FontSize="{DynamicResource TextSize12}"/>
                    <TextBlock Grid.Column="2" Text="Your version" VerticalAlignment="Center" Foreground="{DynamicResource ApplicationSecondaryText}" FontSize="{DynamicResource TextSize12}"/>
                    <TextBlock Grid.Column="3" Text="Latest / supported" TextWrapping="Wrap" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource ApplicationSecondaryText}" FontSize="{DynamicResource TextSize12}"/>
                    <TextBlock Grid.Column="4" Text="Status" VerticalAlignment="Center" Foreground="{DynamicResource ApplicationSecondaryText}" FontSize="{DynamicResource TextSize12}"/>
                    <TextBlock Grid.Column="5" Text="Actions" VerticalAlignment="Center" Foreground="{DynamicResource ApplicationSecondaryText}" FontSize="{DynamicResource TextSize12}"/>
                </Grid>
            </Border>
            <ItemsControl x:Name="AppList" Background="{DynamicResource AppBg}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:CheckResult}">
                        <Border Style="{StaticResource RowShell}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{DynamicResource LaunchColumnWidth}"/><ColumnDefinition Width="1.55*" MinWidth="146"/>
                                    <ColumnDefinition Width="1.1*" MinWidth="104"/><ColumnDefinition Width="1.2*" MinWidth="122"/>
                                    <ColumnDefinition Width="1.6*" MinWidth="142"/><ColumnDefinition Width="{DynamicResource OptionsColumnWidth}"/>
                                </Grid.ColumnDefinitions>
                                <Button Click="Launch_Click" Style="{StaticResource LaunchButton}" Margin="8,0,8,0" VerticalAlignment="Center"
                                        Visibility="{Binding ShowSimpleLaunch, Converter={StaticResource BoolToVisibility}}"/>
                                <Grid Margin="8,0,8,0" VerticalAlignment="Center" Visibility="{Binding ShowSplitLaunch, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
                                    <Button Click="Launch_Click" Style="{StaticResource LaunchButton}" Padding="2,4"/>
                                    <Button Grid.Column="1" Content="▾" Click="ProfileDropdown_Click" Padding="2,4" Style="{StaticResource RowActionButton}"
                                            IsEnabled="{Binding LaunchEnabled}" ToolTip="{Binding SelectedProfile.DisplayName}" AutomationProperties.Name="Choose EuroScope profile"/>
                                </Grid>
                                <Grid Margin="8,0,8,0" VerticalAlignment="Center" Visibility="{Binding ShowRunningActions, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button x:Name="RowShowButton" Content="Show" Click="ShowRunning_Click" Style="{StaticResource RowActionButton}" Padding="3,4" Margin="0,0,4,0"
                                            IsEnabled="{Binding LaunchEnabled}" ToolTip="Bring the running application's window forward"
                                            AutomationProperties.Name="{Binding DisplayName, StringFormat=Show {0}}"/>
                                    <Button x:Name="RowCloseButton" Grid.Column="1" Content="Close…" Click="CloseApplication_Click" Style="{StaticResource RowActionButton}" Padding="3,4"
                                            IsEnabled="{Binding LaunchEnabled}" ToolTip="Review and ask this application to close normally"
                                            AutomationProperties.Name="{Binding DisplayName, StringFormat=Review closing {0}}"/>
                                </Grid>
                                <StackPanel x:Name="ApplicationLabel" Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Margin" Value="0,0,8,0"/><Style.Triggers><DataTrigger Binding="{Binding IsEuroScopeChild}" Value="True"><Setter Property="Margin" Value="12,0,8,0"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                <TextBlock Text="{Binding DisplayName}"
                                           Foreground="{DynamicResource PrimaryText}" FontSize="{DynamicResource TextSize13}" FontWeight="Medium" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Description}" AutomationProperties.HelpText="{Binding Description}"/>
                                <TextBlock Text="{Binding SelectedProfileCaption}" FontSize="{DynamicResource TextSize11}" Foreground="{DynamicResource ApplicationSecondaryText}"
                                           Visibility="{Binding HasProfiles, Converter={StaticResource BoolToVisibility}}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedProfileCaption}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding DisplayInstalledVersion}" Margin="0,0,8,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryText}" FontSize="{DynamicResource TextSize12}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayInstalledVersion}"/>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding DisplayLatestVersion}" Foreground="{DynamicResource PrimaryText}" FontSize="{DynamicResource TextSize12}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayLatestVersion}"/>
                                    <TextBlock Text="{Binding LatestVersionCaption}" Foreground="{DynamicResource ApplicationSecondaryText}" FontSize="{DynamicResource TextSize11}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LatestVersionCaption}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                    <StackPanel.Style><Style TargetType="StackPanel">
                                        <Setter Property="Margin" Value="0,0,8,0"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding HasGngTransfer}" Value="True"><Setter Property="Margin" Value="0,0,8,4"/></DataTrigger></Style.Triggers>
                                    </Style></StackPanel.Style>
                                    <DockPanel>
                                        <TextBlock Text="{Binding RowStatusSymbol}" Style="{StaticResource RowStatusText}" Margin="0,0,5,0"/>
                                                                                <TextBox x:Name="RowStatusMessage" Text="{Binding RowStatusText, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                                 Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center"
                                                 AutomationProperties.Name="{Binding DetailHeading}" AutomationProperties.HelpText="{Binding DetailText}">
                                            <TextBox.Style><Style TargetType="TextBox">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="CaretBrush" Value="{DynamicResource PrimaryText}"/>
                                                <Setter Property="FontSize" Value="{DynamicResource TextSize13}"/><Setter Property="FontWeight" Value="Medium"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RowStatusKind}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource ApplicationWarningText}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding RowStatusKind}" Value="Update"><Setter Property="Foreground" Value="{DynamicResource ApplicationUpdateText}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding RowStatusKind}" Value="Success"><Setter Property="Foreground" Value="{DynamicResource ApplicationSuccessText}"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style></TextBox.Style>
                                            <TextBox.ToolTip><ToolTip MaxWidth="440"><TextBlock Text="{Binding DetailText, StringFormat={}{0}&#x0a;&#x0a;Ctrl+C copies the full status.}" TextWrapping="Wrap"/></ToolTip></TextBox.ToolTip>
                                            <TextBox.CommandBindings><CommandBinding Command="Copy" CanExecute="CopyApplicationStatus_CanExecute" Executed="CopyApplicationStatus_Executed"/></TextBox.CommandBindings>
                                        </TextBox>
                                    </DockPanel>
                                    <TextBlock Text="{Binding RowExplanation}" Style="{StaticResource RowExplanationText}" ToolTip="{Binding DetailText}"/>
                                </StackPanel>
                                <Button x:Name="RowActionButton" Grid.Column="5" Content="{Binding RowActionText}" Click="RowAction_Click" Margin="0,0,8,0" VerticalAlignment="Center"
                                        Style="{StaticResource ThemedButton}" FontSize="{DynamicResource TextSize12}" MinHeight="28" Padding="4,3"
                                        Visibility="{Binding ShowRowAction, Converter={StaticResource BoolToVisibility}}" IsEnabled="{Binding RowActionEnabled}"
                                        ToolTip="{Binding RowActionTooltip}">
                                    <AutomationProperties.Name><MultiBinding StringFormat="{}{0}: {1}"><Binding Path="DisplayName"/><Binding Path="RowActionText"/></MultiBinding></AutomationProperties.Name>
                                </Button>
                                <ProgressBar Grid.Column="4" Height="3" VerticalAlignment="Bottom" Margin="0,0,8,1" Minimum="0" Maximum="100" Foreground="{DynamicResource ApplicationUpdateText}" Background="{DynamicResource DividerBrush}" BorderThickness="0"
                                             Visibility="{Binding RowProgressVisible, Converter={StaticResource BoolToVisibility}}" IsIndeterminate="{Binding RowProgressIndeterminate}"
                                             Value="{Binding RowProgressValue, Mode=OneWay}" AutomationProperties.Name="{Binding RowStatusText}"/>
                                <ProgressBar Grid.Column="4" Height="3" VerticalAlignment="Bottom" Margin="0,0,8,1" Minimum="0" Maximum="100" Foreground="{DynamicResource ApplicationUpdateText}" Background="{DynamicResource DividerBrush}" BorderThickness="0"
                                             Visibility="{Binding SelfUpdateBusy, Converter={StaticResource BoolToVisibility}}" IsIndeterminate="{Binding SelfUpdateProgressIndeterminate}"
                                             Value="{Binding SelfUpdateProgressValue, Mode=OneWay}" AutomationProperties.Name="{Binding SelfUpdateSummary}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        </ScrollViewer>
        </DockPanel>
        <local:SetupWorkspaceControl x:Name="SetupWorkspace" Visibility="Collapsed"/>
        <ContentControl x:Name="GngFlowHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        Background="{DynamicResource AppBg}" AutomationProperties.Name="Swedish GNG operation"/>

        </Grid>
    </DockPanel>
    </Border>
</Window>
