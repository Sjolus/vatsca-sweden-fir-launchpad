<Window x:Class="VatscaUpdateChecker.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:VatscaUpdateChecker.Models"
        Title="Launchpad settings"
        Height="670" Width="660" MinHeight="500" MinWidth="580"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}">

    <DockPanel Margin="20">

        <!-- Buttons -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="ValidationSummary" TextWrapping="Wrap" Foreground="{DynamicResource WarningFg}"
                       AutomationProperties.LiveSetting="Polite" Margin="0,0,0,6"/>
            <CheckBox x:Name="KeepUnverified" Visibility="Collapsed" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,8">
                <TextBlock Text="I checked these locations. Keep the ones Launchpad could not recognise."
                           TextWrapping="Wrap"/>
            </CheckBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveButton" Content="Save" Width="80" Margin="0,0,8,0"
                    Click="Save_Click"
                    Background="#1a475f" Foreground="White"
                    BorderThickness="0" Padding="0,7" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsPressed"   Value="True"><Setter Property="Opacity" Value="0.7"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="Cancel" Width="80" IsCancel="True" Click="Cancel_Click" Padding="0,7" Cursor="Hand"/>
            </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <Button x:Name="FindInstallationsButton" Content="Find installed ATC programs…" HorizontalAlignment="Left"
                    Click="FindInstallations_Click" Padding="12,8" Background="#1a475f" Foreground="White"/>
            <TextBlock x:Name="DiscoveryStatus" Text="Look for EuroScope, TrackAudio, VACS and vATIS already on this PC, plus Swedish GNG and VatEFS folders. You choose which results Launchpad should use. Nothing is installed or started."
                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,8,0,0"/>
        </StackPanel>
        <!-- Path fields -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <!-- Startup behaviour -->
            <TextBlock Text="Preferences" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,10"/>
            <CheckBox x:Name="CheckOnStartup" Content="Check for updates automatically on startup"
                      Margin="0,0,0,6" Foreground="{DynamicResource PrimaryText}"/>
            <TextBlock Text="Checks only. Downloads and installations always need your action." TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryText}" Margin="22,0,0,20"/>

            <Expander x:Name="ApplicationPaths" Header="Program files and data folders" IsExpanded="False" Foreground="{DynamicResource PrimaryText}">
            <StackPanel Margin="0,12,0,0">
            <TextBlock Text="Choose an installed program file (.exe), not a shortcut or downloaded installer. Folder fields ask for the application’s data instead. Launchpad checks each selection without starting it; leave anything you do not use blank. A suggested location is only a starting point. Save keeps your choices."
                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,16"/>

            <!-- EuroScope exe -->
            <TextBlock Text="EuroScope program (EuroScope.exe)" FontWeight="SemiBold" Margin="0,0,0,4"
                       Foreground="{DynamicResource PrimaryText}"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="EuroscopeExePath" TextChanged="Path_Changed" AutomationProperties.Name="EuroScope executable path" Grid.Column="0" Padding="6,5" FontFamily="Consolas" FontSize="12"/>
                <Button  Grid.Column="2" Content="Suggested" Padding="8,5" Cursor="Hand"
                         ToolTip="Fill in the usual location, then check the result. This does not install anything."
                         AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}, StringFormat='Use typical {0} path'}" Click="InsertDefault_Click" Tag="EuroScope"/>
                <Button  Grid.Column="4" Content="✕" Padding="8,5" Cursor="Hand"
                         AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}, StringFormat='Clear {0} path'}" Click="Clear_Click" Tag="EuroScope"/>
                <Button  Grid.Column="6" Content="Browse…" Padding="10,5" Cursor="Hand"
                         AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}, StringFormat='Browse for {0} executable'}" Click="BrowseExe_Click" Tag="EuroScope"/>
            </Grid>
            <TextBlock x:Name="EuroscopeExeStatus" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
                       Foreground="{DynamicResource SecondaryText}" AutomationProperties.Name="EuroScope program check"
                       AutomationProperties.LiveSetting="Polite"/>

            <!-- EuroScope data folder -->
            <TextBlock Text="EuroScope folder for Swedish GNG data" FontWeight="SemiBold" Margin="0,0,0,4"
                       Foreground="{DynamicResource PrimaryText}"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="EuroscopePath" TextChanged="Path_Changed" AutomationProperties.Name="EuroScope data folder" Grid.Column="0" Padding="6,5" FontFamily="Consolas" FontSize="12"/>
                <Button  Grid.Column="2" Content="Suggested" Padding="8,5" Cursor="Hand"
                         ToolTip="Fill in the usual location, then check the result. This does not install anything."
                         AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}, StringFormat='Use typical {0} path'}" Click="InsertDefault_Click" Tag="EuroscopeData"/>
                <Button  Grid.Column="4" Content="✕" Padding="8,5" Cursor="Hand"
                         AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}, StringFormat='Clear {0} path'}" Click="Clear_Click" Tag="EuroscopeData"/>
                <Button  Grid.Column="6" Content="Browse…" Padding="10,5" Cursor="Hand"
                         AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}, StringFormat='Browse for {0} folder'}" Click="BrowseFolder_Click" Tag="EuroscopeData"/>
            </Grid>
            <TextBlock x:Name="EuroscopeDataStatus" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
                       Foreground="{DynamicResource SecondaryText}" AutomationProperties.Name="Swedish GNG folder check"
                       AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Text="{x:Static models:ApplicationDescriptions.SwedishGng}"
                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,4"/>
            <TextBlock Text="Choose the folder containing the ESAA folder, Swedish profiles (.prf) and ESAA-Sweden sector files (.sct/.ese). Do not choose the ESAA folder itself." TextWrapping="Wrap"
                       FontSize="12" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,12"/>

            <!-- TrackAudio -->
            <TextBlock Text="TrackAudio program (trackaudio.exe)" FontWeight="SemiBold" Margin="0,0,0,4"
                       Foreground="{DynamicResource PrimaryText}"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TrackAudioPath" TextChanged="Path_Changed" AutomationProperties.Name="TrackAudio executable path" Grid.Column="0" Padding="6,5" FontFamily="Consolas" FontSize="12"/>
                <Button  Grid.Column="2" Content="Suggested" Padding="8,5" Cursor="Hand"
                         ToolTip="Fill in the usual location, then check the result. This does not install anything."
                         AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}, StringFormat='Use typical {0} path'}" Click="InsertDefault_Click" Tag="TrackAudio"/>
                <Button  Grid.Column="4" Content="✕" Padding="8,5" Cursor="Hand"
                         AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}, StringFormat='Clear {0} path'}" Click="Clear_Click" Tag="TrackAudio"/>
                <Button  Grid.Column="6" Content="Browse…" Padding="10,5" Cursor="Hand"
                         AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}, StringFormat='Browse for {0} executable'}" Click="BrowseExe_Click" Tag="TrackAudio"/>
            </Grid>
            <TextBlock x:Name="TrackAudioStatus" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
                       Foreground="{DynamicResource SecondaryText}" AutomationProperties.Name="TrackAudio program check"
                       AutomationProperties.LiveSetting="Polite"/>

            <!-- VACS -->
            <TextBlock Text="VACS program (vacs-client.exe)" FontWeight="SemiBold" Margin="0,0,0,4"
                       Foreground="{DynamicResource PrimaryText}"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="VacsPath" TextChanged="Path_Changed" AutomationProperties.Name="VACS executable path" Grid.Column="0" Padding="6,5" FontFamily="Consolas" FontSize="12"/>
                <Button  Grid.Column="2" Content="Suggested" Padding="8,5" Cursor="Hand"
                         ToolTip="Fill in the usual location, then check the result. This does not install anything."
                         AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}, StringFormat='Use typical {0} path'}" Click="InsertDefault_Click" Tag="VACS"/>
                <Button  Grid.Column="4" Content="✕" Padding="8,5" Cursor="Hand"
                         AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}, StringFormat='Clear {0} path'}" Click="Clear_Click" Tag="VACS"/>
                <Button  Grid.Column="6" Content="Browse…" Padding="10,5" Cursor="Hand"
                         AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}, StringFormat='Browse for {0} executable'}" Click="BrowseExe_Click" Tag="VACS"/>
            </Grid>
            <TextBlock x:Name="VacsStatus" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
                       Foreground="{DynamicResource SecondaryText}" AutomationProperties.Name="VACS program check"
                       AutomationProperties.LiveSetting="Polite"/>

            <!-- vATIS -->
            <TextBlock Text="vATIS program (vATIS.exe)" FontWeight="SemiBold" Margin="0,0,0,4"
                       Foreground="{DynamicResource PrimaryText}"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="VatisPath" TextChanged="Path_Changed" AutomationProperties.Name="vATIS executable path" Grid.Column="0" Padding="6,5" FontFamily="Consolas" FontSize="12"/>
                <Button  Grid.Column="2" Content="Suggested" Padding="8,5" Cursor="Hand"
                         ToolTip="Fill in the usual location, then check the result. This does not install anything."
                         AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}, StringFormat='Use typical {0} path'}" Click="InsertDefault_Click" Tag="vATIS"/>
                <Button  Grid.Column="4" Content="✕" Padding="8,5" Cursor="Hand"
                         AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}, StringFormat='Clear {0} path'}" Click="Clear_Click" Tag="vATIS"/>
                <Button  Grid.Column="6" Content="Browse…" Padding="10,5" Cursor="Hand"
                         AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}, StringFormat='Browse for {0} executable'}" Click="BrowseExe_Click" Tag="vATIS"/>
            </Grid>
            <TextBlock x:Name="VatisStatus" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
                       Foreground="{DynamicResource SecondaryText}" AutomationProperties.Name="vATIS program check"
                       AutomationProperties.LiveSetting="Polite"/>

            <!-- VatEFS -->
            <TextBlock Text="VatEFS plugin folder" FontWeight="SemiBold" Margin="0,0,0,4"
                       Foreground="{DynamicResource PrimaryText}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="VatEfsPath" TextChanged="Path_Changed" AutomationProperties.Name="VatEFS folder" Grid.Column="0" Padding="6,5" FontFamily="Consolas" FontSize="12"/>
                <Button  Grid.Column="2" Content="Suggested" Padding="8,5" Cursor="Hand"
                         ToolTip="Fill in the usual location, then check the result. This does not install anything."
                         AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}, StringFormat='Use typical {0} path'}" Click="InsertDefault_Click" Tag="VatEFS"/>
                <Button  Grid.Column="4" Content="✕" Padding="8,5" Cursor="Hand"
                         AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}, StringFormat='Clear {0} path'}" Click="Clear_Click" Tag="VatEFS"/>
                <Button  Grid.Column="6" Content="Browse…" Padding="10,5" Cursor="Hand"
                         AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}, StringFormat='Browse for {0} folder'}" Click="BrowseFolder_Click" Tag="VatEFS"/>
            </Grid>
            <TextBlock x:Name="VatEfsStatus" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
                       Foreground="{DynamicResource SecondaryText}" AutomationProperties.Name="VatEFS folder check"
                       AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Text="{x:Static models:ApplicationDescriptions.VatEfs}"
                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0"/>
            <TextBlock Text="Choose the folder containing VatEFS.dll. Controller profile uses this file when you enable the flight-strip plugin." TextWrapping="Wrap"
                       FontSize="12" Foreground="{DynamicResource SecondaryText}" Margin="0,2,0,0"/>

            </StackPanel>
            </Expander>
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
