<Window x:Class="VatscaUpdateChecker.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Launchpad settings"
        Height="590" Width="660" MinHeight="500" MinWidth="580"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}" Foreground="{DynamicResource PrimaryText}" FontSize="{DynamicResource TextSize12}">

    <DockPanel Margin="20">

        <!-- Buttons -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="ValidationSummary" TextWrapping="Wrap" Foreground="{DynamicResource WarningFg}"
                       AutomationProperties.LiveSetting="Polite" Margin="0,0,0,6"/>
            <CheckBox x:Name="KeepUnverified" Visibility="Collapsed" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,8">
                <TextBlock Text="I checked these locations. Keep the ones Launchpad could not recognise."
                           TextWrapping="Wrap"/>
            </CheckBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveButton" Content="Save" Width="80" Margin="0,0,8,0"
                    Click="Save_Click"
                    Background="#1a475f" Foreground="White"
                    BorderThickness="0" Padding="0,7" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsPressed"   Value="True"><Setter Property="Opacity" Value="0.7"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="Cancel" Width="80" IsCancel="True" Click="Cancel_Click" Padding="0,7" Cursor="Hand"/>
            </StackPanel>
        </StackPanel>

        <!-- Path fields -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <!-- Startup behaviour -->
            <TextBlock Text="Preferences" FontSize="{DynamicResource TextSize16}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,10"/>
            <CheckBox x:Name="CheckOnStartup" Content="Check for updates when Launchpad opens"
                      Margin="0,0,0,6" Foreground="{DynamicResource PrimaryText}"/>
            <TextBlock Text="Downloads and installations still need your approval." TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryText}" Margin="22,0,0,12"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Text size" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource PrimaryText}"/>
                <ComboBox x:Name="TextSizeChoice" MinWidth="150" SelectedIndex="0" AutomationProperties.Name="Text size">
                    <ComboBoxItem Content="Standard (100%)" Tag="1"/>
                    <ComboBoxItem Content="Larger (125%)" Tag="1.25"/>
                    <ComboBoxItem Content="Largest (150%)" Tag="1.5"/>
                </ComboBox>
            </StackPanel>
            <CheckBox x:Name="CompactLayoutChoice" Content="Use compact rows" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,10"/>
            <CheckBox x:Name="AlwaysOnTopChoice" Content="Keep Launchpad on top of other windows" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,14"/>
            <Expander Header="Applications I don't use" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,14">
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="Hide update reminders for these applications. Saved locations and data are kept."
                               TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,8"/>
                    <StackPanel x:Name="NotUsedChoices"/>
                </StackPanel>
            </Expander>

            <Button Content="Privacy and support ID…" Click="PrivacySupport_Click" HorizontalAlignment="Left" Margin="0,0,0,5"/>
            <TextBlock Text="Reporting choices, recent reports and your support ID."
                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,14"/>
            <Expander x:Name="ApplicationPaths" Header="Application locations" IsExpanded="False" Foreground="{DynamicResource PrimaryText}">
            <StackPanel Margin="0,12,0,0">
            <WrapPanel Margin="0,0,0,8">
                <Button x:Name="FindInstallationsButton" Content="Find installed copies…" Click="FindInstallations_Click" Padding="10,6" Margin="0,0,10,0"/>
                <TextBlock Text="Changes are kept when you Save." VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/>
            </WrapPanel>
            <TextBlock x:Name="DiscoveryStatus" Text="" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
            <Expander Header="Which file or folder?" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,12">
                <TextBlock Text="For programs, choose the installed .exe, not a shortcut or downloaded installer. For GNG, choose the EuroScope folder containing ESAA, Swedish profiles and sector files. For VatEFS, choose the folder containing VatEFS.dll. Launchpad checks the location without starting the program."
                           TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,6,0,0"/>
            </Expander>

            <!-- EuroScope exe -->
            <TextBlock Text="EuroScope program (EuroScope.exe)" FontWeight="SemiBold" Margin="0,0,0,4"
                       Foreground="{DynamicResource PrimaryText}"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="EuroscopeExePath" TextChanged="Path_Changed" AutomationProperties.Name="EuroScope executable path" Grid.Column="0" Padding="6,5" FontFamily="Consolas" FontSize="{DynamicResource TextSize12}"/>
                <Button  Grid.Column="2" Content="✕" Padding="8,5" Cursor="Hand"
                         AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}, StringFormat='Clear {0} path'}" Click="Clear_Click" Tag="EuroScope"/>
                <Button  Grid.Column="4" Content="Change…" Padding="10,5" Cursor="Hand"
                         AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}, StringFormat='Browse for {0} executable'}" Click="BrowseExe_Click" Tag="EuroScope"/>
            </Grid>
            <TextBlock x:Name="EuroscopeExeStatus" TextWrapping="Wrap" FontSize="{DynamicResource TextSize12}" Margin="0,0,0,10"
                       Foreground="{DynamicResource SecondaryText}" AutomationProperties.Name="EuroScope program check"
                       AutomationProperties.LiveSetting="Polite"/>

            <!-- EuroScope data folder -->
            <TextBlock Text="EuroScope folder for Swedish GNG data" FontWeight="SemiBold" Margin="0,0,0,4"
                       Foreground="{DynamicResource PrimaryText}"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="EuroscopePath" TextChanged="Path_Changed" AutomationProperties.Name="EuroScope data folder" Grid.Column="0" Padding="6,5" FontFamily="Consolas" FontSize="{DynamicResource TextSize12}"/>
                <Button  Grid.Column="2" Content="✕" Padding="8,5" Cursor="Hand"
                         AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}, StringFormat='Clear {0} path'}" Click="Clear_Click" Tag="EuroscopeData"/>
                <Button  Grid.Column="4" Content="Change…" Padding="10,5" Cursor="Hand"
                         AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}, StringFormat='Browse for {0} folder'}" Click="BrowseFolder_Click" Tag="EuroscopeData"/>
            </Grid>
            <TextBlock x:Name="EuroscopeDataStatus" TextWrapping="Wrap" FontSize="{DynamicResource TextSize12}" Margin="0,0,0,10"
                       Foreground="{DynamicResource SecondaryText}" AutomationProperties.Name="Swedish GNG folder check"
                       AutomationProperties.LiveSetting="Polite"/>

            <!-- TrackAudio -->
            <TextBlock Text="TrackAudio program (trackaudio.exe)" FontWeight="SemiBold" Margin="0,0,0,4"
                       Foreground="{DynamicResource PrimaryText}"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TrackAudioPath" TextChanged="Path_Changed" AutomationProperties.Name="TrackAudio executable path" Grid.Column="0" Padding="6,5" FontFamily="Consolas" FontSize="{DynamicResource TextSize12}"/>
                <Button  Grid.Column="2" Content="✕" Padding="8,5" Cursor="Hand"
                         AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}, StringFormat='Clear {0} path'}" Click="Clear_Click" Tag="TrackAudio"/>
                <Button  Grid.Column="4" Content="Change…" Padding="10,5" Cursor="Hand"
                         AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}, StringFormat='Browse for {0} executable'}" Click="BrowseExe_Click" Tag="TrackAudio"/>
            </Grid>
            <TextBlock x:Name="TrackAudioStatus" TextWrapping="Wrap" FontSize="{DynamicResource TextSize12}" Margin="0,0,0,10"
                       Foreground="{DynamicResource SecondaryText}" AutomationProperties.Name="TrackAudio program check"
                       AutomationProperties.LiveSetting="Polite"/>

            <!-- VACS -->
            <TextBlock Text="VACS program (vacs.exe or vacs-client.exe)" FontWeight="SemiBold" Margin="0,0,0,4"
                       Foreground="{DynamicResource PrimaryText}"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="VacsPath" TextChanged="Path_Changed" AutomationProperties.Name="VACS executable path" Grid.Column="0" Padding="6,5" FontFamily="Consolas" FontSize="{DynamicResource TextSize12}"/>
                <Button  Grid.Column="2" Content="✕" Padding="8,5" Cursor="Hand"
                         AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}, StringFormat='Clear {0} path'}" Click="Clear_Click" Tag="VACS"/>
                <Button  Grid.Column="4" Content="Change…" Padding="10,5" Cursor="Hand"
                         AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}, StringFormat='Browse for {0} executable'}" Click="BrowseExe_Click" Tag="VACS"/>
            </Grid>
            <TextBlock x:Name="VacsStatus" TextWrapping="Wrap" FontSize="{DynamicResource TextSize12}" Margin="0,0,0,10"
                       Foreground="{DynamicResource SecondaryText}" AutomationProperties.Name="VACS program check"
                       AutomationProperties.LiveSetting="Polite"/>

            <!-- vATIS -->
            <TextBlock Text="vATIS program (vATIS.exe)" FontWeight="SemiBold" Margin="0,0,0,4"
                       Foreground="{DynamicResource PrimaryText}"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="VatisPath" TextChanged="Path_Changed" AutomationProperties.Name="vATIS executable path" Grid.Column="0" Padding="6,5" FontFamily="Consolas" FontSize="{DynamicResource TextSize12}"/>
                <Button  Grid.Column="2" Content="✕" Padding="8,5" Cursor="Hand"
                         AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}, StringFormat='Clear {0} path'}" Click="Clear_Click" Tag="vATIS"/>
                <Button  Grid.Column="4" Content="Change…" Padding="10,5" Cursor="Hand"
                         AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}, StringFormat='Browse for {0} executable'}" Click="BrowseExe_Click" Tag="vATIS"/>
            </Grid>
            <TextBlock x:Name="VatisStatus" TextWrapping="Wrap" FontSize="{DynamicResource TextSize12}" Margin="0,0,0,10"
                       Foreground="{DynamicResource SecondaryText}" AutomationProperties.Name="vATIS program check"
                       AutomationProperties.LiveSetting="Polite"/>

            <!-- VatEFS -->
            <TextBlock Text="VatEFS plugin folder" FontWeight="SemiBold" Margin="0,0,0,4"
                       Foreground="{DynamicResource PrimaryText}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="VatEfsPath" TextChanged="Path_Changed" AutomationProperties.Name="VatEFS folder" Grid.Column="0" Padding="6,5" FontFamily="Consolas" FontSize="{DynamicResource TextSize12}"/>
                <Button  Grid.Column="2" Content="✕" Padding="8,5" Cursor="Hand"
                         AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}, StringFormat='Clear {0} path'}" Click="Clear_Click" Tag="VatEFS"/>
                <Button  Grid.Column="4" Content="Change…" Padding="10,5" Cursor="Hand"
                         AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}, StringFormat='Browse for {0} folder'}" Click="BrowseFolder_Click" Tag="VatEFS"/>
            </Grid>
            <TextBlock x:Name="VatEfsStatus" TextWrapping="Wrap" FontSize="{DynamicResource TextSize12}" Margin="0,0,0,10"
                       Foreground="{DynamicResource SecondaryText}" AutomationProperties.Name="VatEFS folder check"
                       AutomationProperties.LiveSetting="Polite"/>

            </StackPanel>
            </Expander>
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
