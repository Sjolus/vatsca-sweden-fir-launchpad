<Window x:Class="VatscaUpdateChecker.GngFileDiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Expected file changes" Width="1000" Height="700" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBg}" Foreground="{DynamicResource PrimaryText}">
    <Window.Resources>
        <Style x:Key="PreviewText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="True"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Padding="12,7" Background="{DynamicResource RowAltBg}"
                                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Margin="0,0,4,0">
                            <ContentPresenter x:Name="TabHeader" ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ApplicationSelectedBg}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource ApplicationUpdateText}"/>
                                <Setter TargetName="TabHeader" Property="TextElement.FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource ButtonFocusBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition x:Name="HeaderRow" Height="Auto"/><RowDefinition x:Name="BodyRow" Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer x:Name="HeaderScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
        <StackPanel>
            <TextBlock Text="Expected file changes" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="ActionText" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,4" TextWrapping="Wrap"/>
            <TextBox x:Name="FilePathText" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" MaxHeight="64"
                     VerticalScrollBarVisibility="Auto" Padding="6" AutomationProperties.Name="File within the GNG package"/>
            <TextBox x:Name="SummaryText" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" MaxHeight="92"
                     VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryText}"
                     Padding="0" Margin="0,8,0,0" AutomationProperties.Name="Expected change summary"/>
            <TextBlock x:Name="MaskingNotice" Text="Sensitive values are masked in text previews. Some personal files are shown as summaries only."
                       Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
        </ScrollViewer>
        <TabControl x:Name="PreviewTabs" Grid.Row="1" Background="{DynamicResource AppBg}" BorderBrush="{DynamicResource DividerBrush}" Padding="8"
                    AutomationProperties.Name="File preview views">
            <TabItem x:Name="ChangesTab" Header="Changes" IsSelected="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="+ added / − removed · @@ marks the line numbers in each file" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBox x:Name="DiffSummaryText" Grid.Row="1" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" MaxHeight="56"
                             VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryText}"
                             Padding="0" Margin="0,0,0,8" AutomationProperties.Name="Text difference summary"/>
                    <TextBox x:Name="DiffText" Grid.Row="2" Style="{StaticResource PreviewText}" AutomationProperties.Name="Expected text changes"/>
                </Grid>
            </TabItem>
            <TabItem x:Name="BeforeAfterTab" Header="Before / After">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Current file" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Grid.Column="2" Text="After installation" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="CurrentText" Grid.Row="1" Style="{StaticResource PreviewText}" AutomationProperties.Name="Current file text, sensitive values masked"/>
                    <TextBox x:Name="AfterText" Grid.Row="1" Grid.Column="2" Style="{StaticResource PreviewText}" AutomationProperties.Name="File text after installation, sensitive values masked"/>
                </Grid>
            </TabItem>
        </TabControl>
        <Button x:Name="CloseButton" Grid.Row="2" Content="Close" IsCancel="True" Click="Close_Click" HorizontalAlignment="Right" Margin="0,12,0,0"/>
    </Grid>
</Window>
