<Window x:Class="VatscaUpdateChecker.SaamanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage SAAMAN" Width="800" Height="760" MinWidth="620" MinHeight="510"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBg}"
        Foreground="{DynamicResource PrimaryText}" FontSize="{DynamicResource TextSize12}">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="SAAMAN · Arlanda arrival manager" FontSize="{DynamicResource TextSize22}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="Install the latest stable plugin, update your selected copy, or choose an existing SAAMAN DLL."
                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,8,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <ProgressBar x:Name="Activity" Height="6" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,0,0,8"/>
            <TextBox x:Name="StatusText" Text="Choose a copy or review the latest stable release." IsReadOnly="True" TextWrapping="Wrap"
                     MaxHeight="90" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                     Foreground="{DynamicResource PrimaryText}" AutomationProperties.Name="SAAMAN management status"/>
            <CheckBox x:Name="ConfirmChange" IsEnabled="False" Checked="ConfirmationChanged" Unchecked="ConfirmationChanged"
                      Foreground="{DynamicResource PrimaryText}" Margin="0,10,0,0">
                <TextBlock Text="I reviewed the version, destination and recovery plan, and all EuroScope instances are closed." TextWrapping="Wrap"/>
            </CheckBox>
            <WrapPanel HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="ReviewButton" Content="Review install / update" Click="Review_Click" Padding="12,8" Margin="0,0,8,6"/>
                <Button x:Name="ApplyButton" Content="Install reviewed release" Click="Apply_Click" IsEnabled="False" Padding="12,8" Margin="0,0,8,6"/>
                <Button x:Name="CancelOperationButton" Content="Cancel preparation" Click="CancelOperation_Click" Visibility="Collapsed" Padding="12,8" Margin="0,0,8,6"/>
                <Button x:Name="CloseButton" Content="Close" Click="Close_Click" IsCancel="True" Padding="12,8" Margin="0,0,0,6"/>
            </WrapPanel>
        </StackPanel>
        <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <StackPanel x:Name="OptionsPanel">
                    <TextBlock Text="Plugin copy" FontSize="{DynamicResource TextSize16}" FontWeight="SemiBold"/>
                    <TextBox x:Name="DllPathText" IsReadOnly="True" TextWrapping="Wrap" Padding="8" Margin="0,6,0,8"
                             Background="{DynamicResource RowBg}" Foreground="{DynamicResource PrimaryText}" AutomationProperties.Name="SAAMAN DLL path"/>
                    <WrapPanel Margin="0,0,0,12">
                        <Button Content="Choose existing DLL…" Click="Adopt_Click" Padding="10,6" Margin="0,0,8,6"/>
                        <Button Content="Release notes ↗" Click="ReleaseNotes_Click" Padding="10,6" Margin="0,0,8,6"/>
                        <Button x:Name="RuntimeButton" Content="Check WebView2 requirement" Click="Runtime_Click" Padding="10,6" Margin="0,0,0,6"/>
                    </WrapPanel>
                    <TextBlock Text="EuroScope profile" FontWeight="SemiBold"/>
                    <TextBlock Text="Controller profile offers a separate opt-in to load SAAMAN in ESAA APP ACC.prf and place it before TopSky. Choose another profile here if your GNG package uses a different name."
                               TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,5,0,8"/>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="Choose profile…" Click="ChooseProfile_Click" Padding="10,6" Margin="8,0,0,0"/>
                        <TextBox x:Name="ProfilePathText" IsReadOnly="True" TextWrapping="Wrap" Padding="6" AutomationProperties.Name="SAAMAN profile path"/>
                    </DockPanel>
                </StackPanel>
                <TextBlock Text="Review" FontSize="{DynamicResource TextSize16}" FontWeight="SemiBold" Margin="0,6,0,8"/>
                <TextBox x:Name="ReviewText" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" MinHeight="130" MaxHeight="270"
                         VerticalScrollBarVisibility="Auto" Padding="10" Background="{DynamicResource RowBg}" Foreground="{DynamicResource PrimaryText}"
                         AutomationProperties.Name="Reviewed SAAMAN change"
                         Text="A version check downloads no plugin. Installation replaces only the selected DLL after size, SHA-256 and static plugin identity checks. Existing plugin bytes have a verified recovery copy. SAAMAN preferences and browser state stay in LocalAppData\SAAMAN."/>
                <WrapPanel Margin="0,8,0,0">
                    <Button x:Name="RecoveryButton" Content="Review latest recovery…" Click="Recovery_Click" Padding="10,6" Margin="0,0,8,6"/>
                    <Button x:Name="RestoreButton" Content="Restore reviewed change" Click="Restore_Click" IsEnabled="False" Padding="10,6" Margin="0,0,0,6"/>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
