<Window x:Class="VatscaUpdateChecker.SaamanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAAMAN" Width="740" Height="560" MinWidth="620" MinHeight="510"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBg}"
        Foreground="{DynamicResource PrimaryText}" FontSize="{DynamicResource TextSize12}">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="SAAMAN · Arlanda arrival manager" FontSize="{DynamicResource TextSize22}" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <ProgressBar x:Name="Activity" Height="6" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,0,0,8"/>
            <TextBox x:Name="StatusText" Text="Choose an existing DLL or install the latest stable release." IsReadOnly="True" TextWrapping="Wrap"
                     MaxHeight="90" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                     Foreground="{DynamicResource PrimaryText}" AutomationProperties.Name="SAAMAN management status"/>
            <CheckBox x:Name="ConfirmChange" IsEnabled="False" Visibility="Collapsed" Checked="ConfirmationChanged" Unchecked="ConfirmationChanged"
                      Foreground="{DynamicResource PrimaryText}" Margin="0,10,0,0">
                <TextBlock x:Name="ConfirmChangeText" Text="I have reviewed this change." TextWrapping="Wrap"/>
            </CheckBox>
            <TextBlock x:Name="ProcessBlockText" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{DynamicResource WarningFg}" Margin="0,0,0,6" AutomationProperties.LiveSetting="Polite"/>
            <WrapPanel HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="InstallButton" Content="Install / update SAAMAN" Click="Install_Click" Padding="12,8" Margin="0,0,8,6"/>
                <Button x:Name="CancelReviewButton" Content="Cancel change" Click="CancelReview_Click" Visibility="Collapsed" Padding="12,8" Margin="0,0,8,6"/>
                <Button x:Name="CancelOperationButton" Content="Cancel preparation" Click="CancelOperation_Click" Visibility="Collapsed" Padding="12,8" Margin="0,0,8,6"/>
                <Button x:Name="CloseButton" Content="Close" Click="Close_Click" IsCancel="True" Padding="12,8" Margin="0,0,0,6"/>
            </WrapPanel>
        </StackPanel>
        <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <StackPanel x:Name="OptionsPanel">
                    <TextBlock Text="Plugin DLL" FontSize="{DynamicResource TextSize16}" FontWeight="SemiBold"/>
                    <TextBox x:Name="DllPathText" IsReadOnly="True" TextWrapping="Wrap" Padding="8" Margin="0,6,0,8"
                             Background="{DynamicResource RowBg}" Foreground="{DynamicResource PrimaryText}" AutomationProperties.Name="SAAMAN DLL path"/>
                    <WrapPanel Margin="0,0,0,12">
                        <Button x:Name="AdoptButton" Content="Choose existing DLL…" Click="Adopt_Click" Padding="10,6" Margin="0,0,8,6"/>
                        <Button Content="Release notes ↗" Click="ReleaseNotes_Click" Padding="10,6" Margin="0,0,8,6"/>
                        <Button x:Name="RuntimeButton" Content="Check WebView2" Click="Runtime_Click" Padding="10,6" Margin="0,0,0,6"/>
                    </WrapPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="ⓘ" Width="28" Padding="0" Click="ProfileInfo_Click"
                                LostKeyboardFocus="ProfileInfo_Close" AutomationProperties.Name="About SAAMAN profile changes">
                            <Button.ToolTip>
                                <ToolTip Background="{DynamicResource RowBg}" Foreground="{DynamicResource PrimaryText}" Padding="10">
                                    <TextBlock Width="340" TextWrapping="Wrap" Text="Changes apply immediately, with a recovery copy. SAAMAN runs inside EuroScope. Enabling it puts it first in this APP/ACC profile and replaces MAESTRO. Disabling restores the original MAESTRO entries. Other profiles and controller credentials are unchanged. Choosing a different DLL updates the profile when enabled. To switch profiles, disable it here first."/>
                                </ToolTip>
                            </Button.ToolTip>
                        </Button>
                        <TextBlock Text="EuroScope profile" FontSize="{DynamicResource TextSize16}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Button x:Name="ChooseProfileButton" DockPanel.Dock="Right" Content="Choose profile…" Click="ChooseProfile_Click" Padding="10,6" Margin="8,0,0,0"/>
                        <TextBox x:Name="ProfilePathText" IsReadOnly="True" TextWrapping="Wrap" Padding="6" AutomationProperties.Name="SAAMAN profile path"/>
                    </DockPanel>
                    <WrapPanel Margin="0,0,0,4">
                        <CheckBox x:Name="ProfileEnabledCheck" Content="Enable SAAMAN in this profile" VerticalAlignment="Center"
                                  Foreground="{DynamicResource PrimaryText}" Checked="ProfileChoiceChanged" Unchecked="ProfileChoiceChanged" Margin="0,0,14,6"/>
                    </WrapPanel>
                    <TextBlock x:Name="ProfileStateText" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                </StackPanel>
                <StackPanel x:Name="ReviewPanel" Visibility="Collapsed">
                <TextBlock x:Name="ReviewHeading" Text="Review" FontSize="{DynamicResource TextSize16}" FontWeight="SemiBold" Margin="0,6,0,8"/>
                <TextBox x:Name="ReviewText" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="250"
                         VerticalScrollBarVisibility="Auto" Padding="10" Background="{DynamicResource RowBg}" Foreground="{DynamicResource PrimaryText}"
                         AutomationProperties.Name="Reviewed SAAMAN change"/>
                </StackPanel>
                <WrapPanel Margin="0,8,0,0">
                    <Button x:Name="RecoveryButton" Content="Restore previous DLL…" Click="Recovery_Click" Padding="10,6" Margin="0,0,8,6"/>
                    <Button x:Name="RestoreButton" Content="Restore reviewed change" Click="Restore_Click" Visibility="Collapsed" IsEnabled="False" Padding="10,6" Margin="0,0,0,6"/>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
